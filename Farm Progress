--// Progress animation
local function AnimateBar(progress)
    if CurrentTween then
        CurrentTween:Cancel()
    end

    CurrentTween = TweenService:Create(
        bar,
        TweenInfo.new(
            0.2,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.new(progress, 0, 1, 0)
        }
    )

    CurrentTween:Play()
end

--// Reset counter
local function ResetCounter()
    TimerVersion += 1

    StartTime = nil
    Finished = false

    roundTimerLabel.Text = "Time: 0s"
    candiesCountInsideLabel.Text = "0 / 50"

    bar.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    timerStroke.Color = Color3.fromRGB(255, 140, 0)

    AnimateBar(0)
end

--// Timer
local function StartTimer()
    if StartTime or Finished then return end

    StartTime = os.clock()
    TimerVersion += 1

    local version = TimerVersion

    task.spawn(function()
        while timerGui.Parent
            and version == TimerVersion
            and not Finished do

            task.wait(1)

            if version ~= TimerVersion or Finished then
                break
            end

            local elapsed = math.floor(os.clock() - StartTime)
            roundTimerLabel.Text = string.format("Time: %ds", elapsed)
        end
    end)
end

--// Update candy
local function UpdateCandy(amount, maximum)
    amount = tonumber(amount) or 0
    maximum = math.max(tonumber(maximum) or 50, 1)
    amount = math.clamp(amount, 0, maximum)

    if Finished then return end

    -- Start on first candy
    if amount > 0 and not StartTime then
        StartTimer()
    end

    -- Full collection
    if amount >= maximum then
        Finished = true

        local finalTime = math.floor(os.clock() - StartTime)

        roundTimerLabel.Text = string.format("FULL - %ds", finalTime)
        candiesCountInsideLabel.Text = "FULL"

        bar.BackgroundColor3 = Color3.fromRGB(0, 220, 80)
        timerStroke.Color = Color3.fromRGB(0, 220, 80)

        AnimateBar(1)
        return
    end

    candiesCountInsideLabel.Text = string.format(
        "%d / %d",
        amount,
        maximum
    )

    AnimateBar(amount / maximum)
end

--// Remote listener
Track(Remote.OnClientEvent:Connect(function(coinType, amount, maximum)
    if coinType == "Candy" then
        UpdateCandy(amount, maximum)
    end
end))

--// Respawn reset
Track(localPlayer.CharacterAdded:Connect(ResetCounter))

--// Initial reset
ResetCounter()

--// Cleanup
Environment.ZanwahCandyCleanup = function()
    TimerVersion += 1

    for _, connection in ipairs(Connections) do
        connection:Disconnect()
    end

    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end

    if timerGui.Parent then
        timerGui:Destroy()
    end
end
