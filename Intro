-- Sound Helper Function with custom volume support
local function playSound(soundId, customVolume)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(soundId)
	sound.Volume = customVolume or 2
	sound.Parent = SoundService
	sound:Play()
	task.spawn(function()
		sound.Ended:Wait()
		sound:Destroy()
	end)
end

-- TIMELINE & SEQUENTIAL ANIMATIONS --
task.spawn(function()
	-- Play start sound (Volume 2) and smoothly fade background to solid black
	playSound(4580947608, 2)
	local bgFadeIn = TweenService:Create(fadeFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
	bgFadeIn:Play()
	bgFadeIn.Completed:Wait()

	task.wait(0.2)

	-- STEP 1: Show Image first (Volume 2)
	playSound(72264591133889, 2)
	local imgTween = TweenService:Create(imageLabel, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {ImageTransparency = 0})
	imgTween:Play()
	imgTween.Completed:Wait()

	task.wait(0.3)

	-- STEP 2: Show Name (ZANWAH HUB 🎃) second (Volume 2)
	playSound(72264591133889, 2)
	local titleTween = TweenService:Create(titleLabel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0})
	titleTween:Play()
	titleTween.Completed:Wait()

	task.wait(0.3)

	-- STEP 3: Show Loading Bar third and animate it
	TweenService:Create(loadBg, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
	TweenService:Create(percentLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
	task.wait(0.2)

	-- Fake Loading Bar Animation (~1.8 seconds)
	local loadDuration = 1.8
	local startTime = tick()
	while tick() - startTime < loadDuration do
		local alpha = math.clamp((tick() - startTime) / loadDuration, 0, 1)
		local easedAlpha = math.sin(alpha * math.pi / 2) 
		loadFill.Size = UDim2.new(easedAlpha, 0, 1, 0)
		percentLabel.Text = "Loading... " .. math.floor(easedAlpha * 100) .. "%"
		task.wait()
	end
	
	-- 100% Full -> Turn Green and say "Done!"
	loadFill.Size = UDim2.new(1, 0, 1, 0)
	percentLabel.Text = "Done!"
	
	TweenService:Create(loadFill, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(46, 204, 113)}):Play()
	TweenService:Create(percentLabel, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(46, 204, 113)}):Play()
	
	task.wait(0.6)

	-- Fade out loading bar & text smoothly
	TweenService:Create(loadBg, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
	TweenService:Create(loadFill, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
	TweenService:Create(percentLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
	task.wait(0.4)

	-- STEP 4: Drop Custom Sound (Volume 5) & Flash Arabic Text ("يلعن سمير يا شيخ")
	playSound(79823379606976, 5)
	
	arabicLabel.TextSize = 14
	local arabicTweenIn = TweenService:Create(arabicLabel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextTransparency = 0, TextSize = 24})
	arabicTweenIn:Play()

	-- Hold everything on screen
	task.wait(3.5)

	-- Grand Fade Out
	local fadeOutInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(fadeFrame, fadeOutInfo, {BackgroundTransparency = 1}):Play()
	TweenService:Create(imageLabel, fadeOutInfo, {ImageTransparency = 1}):Play()
	TweenService:Create(titleLabel, fadeOutInfo, {TextTransparency = 1}):Play()
	local finalOut = TweenService:Create(arabicLabel, fadeOutInfo, {TextTransparency = 1})
	finalOut:Play()
	finalOut.Completed:Wait()

	-- Clean up UI instance entirely
	screenGui:Destroy()
end)
