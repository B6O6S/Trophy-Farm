local player = Players.LocalPlayer
if not player then return end

-- Prevent duplicate execution
local existingGui = CoreGui:FindFirstChild("AutoVoteUltimateGui") or player.PlayerGui:FindFirstChild("AutoVoteUltimateGui")
if existingGui then
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "AutoVote",
			Text = "Script is already active!",
			Duration = 3
		})
	end)
	return
end

