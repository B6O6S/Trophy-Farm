local function CreateBadge(text, position, color)
	local badge = Instance.new("Frame")
	badge.Size = UDim2.new(0.48, 0, 1, 0)
	badge.Position = position
	badge.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
	badge.BorderSizePixel = 0
	badge.Parent = BadgesFrame

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 6)
	bCorner.Parent = badge

	local bStroke = Instance.new("UIStroke")
	bStroke.Color = color
	bStroke.Thickness = 1
	bStroke.Transparency = 0.5
	bStroke.Parent = badge

	local bLabel = Instance.new("TextLabel")
	bLabel.Size = UDim2.new(1, 0, 1, 0)
	bLabel.BackgroundTransparency = 1
	bLabel.Text = text
	bLabel.TextColor3 = color
	bLabel.TextSize = 10
	bLabel.Font = Enum.Font.GothamBold
	bLabel.Parent = badge

	return badge
end

CreateBadge("MODE: SMALLEST", UDim2.new(0, 0, 0, 0), Color3.fromRGB(0, 255, 170))
