local function getPlayerData()
	local getPlayerDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not getPlayerDataRemote then return nil, nil, "" end

	local success, result = pcall(function()
		return getPlayerDataRemote:InvokeServer()
	end)
	if not success or not result then return nil, nil, "" end

	local myRole = nil
	local murdererPlayerName = nil
	local roundIdentifier = ""

	for playerName, data in pairs(result) do
		roundIdentifier = roundIdentifier .. playerName .. (data.Role or "")
		if playerName == LP.Name then
			myRole = data.Role
		end
		if data.Role == "Murderer" then
			murdererPlayerName = playerName
		end
	end

	return myRole, murdererPlayerName, roundIdentifier
end

local function hasGunTool()
	local char = LP.Character
	local bp = LP:FindFirstChild("Backpack")
	
	if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then
		return true
	end
	if bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function targetHasGun(targetPlayer)
	if not targetPlayer then return false end
	local char = targetPlayer.Character
	local bp = targetPlayer:FindFirstChild("Backpack")

	if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then
		return true
	end
	if bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function anyoneHasWeapon()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local bp = player:FindFirstChild("Backpack")
		
		local hasCharWeapon = char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("Knife"))
		local hasBpWeapon = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver") or bp:FindFirstChild("Knife"))
		
		if hasCharWeapon or hasBpWeapon then
			return true
		end
	end
	return false
end

local function hasValidMurdererTargets()
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= LP and not isExactWhitelisted(target) then
			local targetChar = target.Character
			if targetChar then
				local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
				if targetHum and targetHum.Health > 0 then
					return true
				end
			end
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- MURDERER AUTOMATION LOGIC (EQUIP KNIFE & TP EXACT-WHITELIST EXCLUDED TARGETS)
--------------------------------------------------------------------------------
local function runMurdererLogic()
	if isMurdererLoopRunning then return end
	isMurdererLoopRunning = true

	task.spawn(function()
		task.wait(5) -- Wait 5 seconds after role start
		local baseCFrame = CFrame.new(620, 562, 35)

		while isMurdererLoopRunning do
			local char = LP.Character
			local backpack = LP:FindFirstChild("Backpack")
			
			if not char then
				task.wait(0.1)
				continue
			end

			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")

			if not (humanoid and root and humanoid.Health > 0) then
				break
			end

			-- Hold base position
			pcall(function()
				root.CFrame = baseCFrame
			end)

			-- Search for knife
			local knife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
			
			if knife and hasValidMurdererTargets() then
				if backpack and knife.Parent == backpack then
					pcall(function()
						humanoid:EquipTool(knife)
					end)
					task.wait(0.05)
				end

				-- Teleport non-exact-whitelisted targets to your screen and activate knife (prefixes can be killed)
				for _, target in ipairs(Players:GetPlayers()) do
					if target ~= LP and not isExactWhitelisted(target) then
						local targetChar = target.Character
						if targetChar then
							local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
							local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

							if targetRoot and targetHum and targetHum.Health > 0 then
								pcall(function()
									targetRoot.CFrame = root.CFrame * CFrame.new(0, 0, -2)
									knife:Activate()
								end)
								task.wait(0.03)
							end
						end
					end
				end
			end

			task.wait(0.05)
		end
	end)
end

