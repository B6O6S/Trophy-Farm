local function getPlayerData()
	local getPlayerDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not getPlayerDataRemote then return nil, nil, "" end

	local success, result = pcall(function()
		return getPlayerDataRemote:InvokeServer()
	end)
	if not success or not result then return nil, nil, "" end

	local myRole = nil
	local murdererPlayerName = nil
	local roundIdentifier = ""

	for playerName, data in pairs(result) do
		roundIdentifier = roundIdentifier .. playerName .. (data.Role or "")
		if playerName == LP.Name then
			myRole = data.Role
		end
		if data.Role == "Murderer" then
			murdererPlayerName = playerName
		end
	end

	return myRole, murdererPlayerName, roundIdentifier
end

local function isHoldingGun()
	local char = LP.Character
	if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

-- Checks if a target player has a gun equipped or in their backpack
local function targetHasGun(targetPlayer)
	if not targetPlayer then return false end
	local char = targetPlayer.Character
	local bp = targetPlayer:FindFirstChild("Backpack")

	if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then
		return true
	end
	if bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function anyoneHasWeapon()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local bp = player:FindFirstChild("Backpack")
		
		local hasCharWeapon = char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("Knife"))
		local hasBpWeapon = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver") or bp:FindFirstChild("Knife"))
		
		if hasCharWeapon or hasBpWeapon then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- CONTINUOUS GUN HOLD TIMER MONITORING
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if tick() - scriptLoadTime > INITIAL_LOAD_DELAY then
			if isHoldingGun() and not isResettingFromHold then
				gunHeldTimer = gunHeldTimer + 0.5
				if gunHeldTimer >= 5 then
					isResettingFromHold = true
					local _, murdererPlayerName = getPlayerData()
					local isLocalRestricted = isRestrictedUser(LP.Name)
					local isMurdererRestricted = murdererPlayerName and isRestrictedUser(murdererPlayerName)

					if not (isLocalRestricted or isMurdererRestricted) then
						local character = LP.Character
						if character then
							local humanoid = character:FindFirstChild("Humanoid")
							if humanoid then humanoid.Health = 0 end
						end
					end
				end
			else
				gunHeldTimer = 0
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- RESTRICTED USERS STILLNESS MONITOR
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if tick() - scriptLoadTime > INITIAL_LOAD_DELAY and not isResettingFromTargetStill then
			if anyoneHasWeapon() then
				for _, name in ipairs(restrictedNames) do
					local targetPlayer = Players:FindFirstChild(name)
					
					-- Check if restricted user is in game and does NOT have the gun
					if targetPlayer and not targetHasGun(targetPlayer) then
						if targetPlayer.Character then
							local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
							if targetRoot then
								local currentPos = targetRoot.Position
								local lastPos = targetLastPositions[name]

								if lastPos then
									if (currentPos - lastPos).Magnitude < 0.5 then
										targetStillTimers[name] = (targetStillTimers[name] or 0) + 0.5
									else
										targetStillTimers[name] = 0
									end
								else
									targetStillTimers[name] = 0
									targetLastPositions[name] = currentPos
								end
								targetLastPositions[name] = currentPos

								if (targetStillTimers[name] or 0) >= 5 then
									isResettingFromTargetStill = true
									local character = LP.Character
									if character then
										local humanoid = character:FindFirstChild("Humanoid")
										if humanoid then humanoid.Health = 0 end
									end
									break
								end
							end
						end
					else
						targetStillTimers[name] = 0
						targetLastPositions[name] = nil
					end
				end
			else
				for _, name in ipairs(restrictedNames) do
					targetStillTimers[name] = 0
					targetLastPositions[name] = nil
				end
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- ROLE CHECKER & REACTION LOGIC
--------------------------------------------------------------------------------
function CheckRole()
	if tick() - scriptLoadTime <= INITIAL_LOAD_DELAY then return end

	local myRole, murdererPlayerName, roundIdentifier = getPlayerData()
	if not myRole then return end

	if roundIdentifier ~= lastRoundIdentifier then
		lastRoundIdentifier = roundIdentifier
		CleanMap()
		
		if myRole then
			task.spawn(function()
				local isLocalRestricted = isRestrictedUser(LP.Name)
				local isMurdererRestricted = murdererPlayerName and isRestrictedUser(murdererPlayerName)

				-- Never reset if local player is Innocent or Murderer
				if myRole == "Innocent" or myRole == "Murderer" then
					return

				-- Only process reset if role is Sheriff or Hero
				elseif myRole == "Sheriff" or myRole == "Hero" then
					if not (isLocalRestricted or isMurdererRestricted) then
						task.wait(5)
						if tick() - scriptLoadTime > INITIAL_LOAD_DELAY then
							local character = LP.Character
							if character then
								local humanoid = character:FindFirstChild("Humanoid")
								if humanoid then humanoid.Health = 0 end
							end
						end
					end
					return
				end
			end)
		end
	end
end

RunService.RenderStepped:Connect(function()
	pcall(CheckRole)
end)
