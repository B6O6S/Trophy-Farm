local function getPlayerData()
	local getPlayerDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not getPlayerDataRemote then return nil, nil, "" end

	local success, result = pcall(function()
		return getPlayerDataRemote:InvokeServer()
	end)
	if not success or not result then return nil, nil, "" end

	local myRole = nil
	local murdererPlayerName = nil
	local roundIdentifier = ""

	for playerName, data in pairs(result) do
		roundIdentifier = roundIdentifier .. playerName .. (data.Role or "")
		if playerName == LP.Name then
			myRole = data.Role
		end
		if data.Role == "Murderer" then
			murdererPlayerName = playerName
		end
	end

	return myRole, murdererPlayerName, roundIdentifier
end

local function isHoldingGun()
	local char = LP.Character
	if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function hasGunTool()
	local char = LP.Character
	local backpack = LP:FindFirstChild("Backpack")
	if isHoldingGun() then return true end
	if backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function hasKnifeTool()
	local char = LP.Character
	local backpack = LP:FindFirstChild("Backpack")
	if char and char:FindFirstChild("Knife") then return true end
	if backpack and backpack:FindFirstChild("Knife") then return true end
	return false
end

-- Checks if ANY player in the server currently holds or has a gun/knife
local function anyoneHasWeapon()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local bp = player:FindFirstChild("Backpack")
		
		local hasCharWeapon = char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("Knife"))
		local hasBpWeapon = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver") or bp:FindFirstChild("Knife"))
		
		if hasCharWeapon or hasBpWeapon then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- GUN HOLD TIMER MONITORING
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if tick() - scriptLoadTime > GRACE_PERIOD then
			if isHoldingGun() and not isResettingFromHold then
				gunHeldTimer = gunHeldTimer + 0.5
				if gunHeldTimer >= 5 then
					isResettingFromHold = true
					local _, murdererPlayerName = getPlayerData()
					local isLocalRestricted = isRestrictedUser(LP.Name)
					local isMurdererRestricted = murdererPlayerName and isRestrictedUser(murdererPlayerName)

					if not (isLocalRestricted or isMurdererRestricted) then
						local character = LP.Character
						if character then
							CleanCharacter(character)
							local humanoid = character:FindFirstChild("Humanoid")
							if humanoid then humanoid.Health = 0 end
						end
					end
				end
			else
				gunHeldTimer = 0
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- B6O6S STILLNESS MONITOR (WHEN WEAPON EXISTS)
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if tick() - scriptLoadTime > GRACE_PERIOD and not isResettingFromTargetStill then
			if anyoneHasWeapon() then
				local targetPlayer = Players:FindFirstChild("B6O6S")
				if targetPlayer and targetPlayer.Character then
					local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					if targetRoot then
						local currentPos = targetRoot.Position
						local lastPos = targetLastPositions["B6O6S"]

						if lastPos then
							if (currentPos - lastPos).Magnitude < 0.5 then
								targetStillTimers["B6O6S"] = (targetStillTimers["B6O6S"] or 0) + 0.5
							else
								targetStillTimers["B6O6S"] = 0
							end
						else
							targetStillTimers["B6O6S"] = 0
						end
						targetLastPositions["B6O6S"] = currentPos

						if (targetStillTimers["B6O6S"] or 0) >= 5 then
							isResettingFromTargetStill = true
							local character = LP.Character
							if character then
								CleanCharacter(character)
								local humanoid = character:FindFirstChild("Humanoid")
								if humanoid then humanoid.Health = 0 end
							end
						end
					end
				end
			else
				targetStillTimers["B6O6S"] = 0
				targetLastPositions["B6O6S"] = nil
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- ROLE CHECKER & REACTION LOGIC
--------------------------------------------------------------------------------
function CheckRole()
	local myRole, murdererPlayerName, roundIdentifier = getPlayerData()
	if not myRole then return end

	if roundIdentifier ~= lastRoundIdentifier then
		lastRoundIdentifier = roundIdentifier
		CleanMap()
		
		if myRole then
			task.spawn(function()
				task.wait(0.5) -- Allow grace period on round change
				if tick() - scriptLoadTime <= GRACE_PERIOD then return end

				local isLocalRestricted = isRestrictedUser(LP.Name)
				local isMurdererRestricted = murdererPlayerName and isRestrictedUser(murdererPlayerName)

				if myRole == "Innocent" then
					if hasGunTool() then
						if not (isLocalRestricted or isMurdererRestricted) then
							task.wait(5)
							if tick() - scriptLoadTime > GRACE_PERIOD then
								local character = LP.Character
								if character then
									CleanCharacter(character)
									local humanoid = character:FindFirstChild("Humanoid")
									if humanoid then humanoid.Health = 0 end
								end
							end
						end
					end
					return

				elseif myRole == "Sheriff" or myRole == "Hero" or hasGunTool() then
					if not (isLocalRestricted or isMurdererRestricted) then
						task.wait(5)
						if tick() - scriptLoadTime > GRACE_PERIOD then
							local character = LP.Character
							if character then
								CleanCharacter(character)
								local humanoid = character:FindFirstChild("Humanoid")
								if humanoid then humanoid.Health = 0 end
							end
						end
					end
					return

				elseif myRole == "Murderer" then
					return
				end
			end)
		end
	end
end

RunService.RenderStepped:Connect(function()
	pcall(CheckRole)
end)
