-- Whitelist Configuration (Exact Names = Never get killed by knife)
local WHITELIST_EXACT = {
	["B6O6S"] = true,
	["3r_q5"] = true,
	["FROOS114"] = true,
	["Silenrix"] = true,
}

-- Prefix accounts (can get killed by murderer)
local WHITELIST_PREFIXES = {
	"altb6",
	"froos",
	"silenrix"
}

-- Check if player is strictly in WHITELIST_EXACT (used for murderer ignore list)
local function isExactWhitelisted(player)
	if not player or not player.Name then return false end
	local nameLower = player.Name:lower()
	
	for exactName, _ in pairs(WHITELIST_EXACT) do
		if exactName:lower() == nameLower then
			return true
		end
	end
	
	return false
end

-- Check if player matches exact or prefix (used for general reset/fling loop safety)
local function isWhitelisted(player)
	if not player or not player.Name then return false end
	local nameLower = player.Name:lower()
	
	for exactName, _ in pairs(WHITELIST_EXACT) do
		if exactName:lower() == nameLower then
			return true
		end
	end
	
	for _, prefix in ipairs(WHITELIST_PREFIXES) do
		if nameLower:sub(1, #prefix) == prefix then
			return true
		end
	end
	
	return false
end

