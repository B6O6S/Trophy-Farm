--------------------------------------------------------------------------------
-- MAP CLEANING & PLATFORM SETUP
--------------------------------------------------------------------------------
local function EnsurePlatform()
	local plat = Workspace:FindFirstChild("MurdererPlatform")
	if not plat then
		plat = Instance.new("Part")
		plat.Name = "MurdererPlatform"
		plat.Size = Vector3.new(20, 1, 20)
		plat.Position = Vector3.new(100, 98, 100)
		plat.Anchored = true
		plat.BrickColor = BrickColor.new("Medium stone grey")
		plat.Transparency = 0.9
		plat.Parent = Workspace
	else
		plat.BrickColor = BrickColor.new("Medium stone grey")
		plat.Transparency = 0.9
	end
	return plat
end

local function ShouldDestroy(obj)
	if not obj or not obj.Parent then return false end
	if obj.Name == "Raggy" or obj:IsA("Sound") then return true end
	if obj:IsA("Decal") and obj.Name:lower() == "face" then return true end
	if obj.Name == "CoinContainer" or obj.Name == "WeaponDisplay" or obj.Name == "WeaponDisplays" or obj.Name == "WeaponsDisplay" then
		return true
	end
	if obj:IsA("Accessory") or obj:IsA("Hat") or obj:IsA("SpecialMesh") or obj:IsA("MeshPart")
		or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke")
		or obj:IsA("Sparkles") or obj:IsA("Beam") or obj:IsA("Explosion") or obj:IsA("Light")
		or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or obj:IsA("Texture")
		or obj:IsA("Clothing") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("FaceControls") then
		return true
	end
	return false
end

local function CleanCharacter(character)
	if not character then return end
	for _, obj in ipairs(character:GetDescendants()) do
		if ShouldDestroy(obj) then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function CleanMap()
	EnsurePlatform()
	pcall(function()
		local displays = Workspace:FindFirstChild("WeaponDisplays")
		if displays then displays:Destroy() end
		local weaponsDisplay = Workspace:FindFirstChild("WeaponsDisplay")
		if weaponsDisplay then weaponsDisplay:Destroy() end
	end)
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if ShouldDestroy(obj) then
			pcall(function() obj:Destroy() end)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			CleanCharacter(player.Character)
		end
	end
end

Workspace.DescendantAdded:Connect(function(obj)
	task.defer(function()
		if obj and obj.Parent and ShouldDestroy(obj) then
			pcall(function() obj:Destroy() end)
		end
	end)
end)

local function SetupCharacter(character)
	if not character then return end
	task.spawn(function()
		task.wait(0.1)
		CleanCharacter(character)
	end)
	character.DescendantAdded:Connect(function(obj)
		task.defer(function()
			if obj and obj.Parent and ShouldDestroy(obj) then
				pcall(function() obj:Destroy() end)
			end
		end)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then SetupCharacter(player.Character) end
	player.CharacterAdded:Connect(SetupCharacter)
end
Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(SetupCharacter)
end)

LP.CharacterAdded:Connect(function(char)
	task.spawn(function()
		task.wait(0.2)
		CleanMap()
		CleanCharacter(char)
	end)
end)

