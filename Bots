--------------------------------------------------------------------------------
-- ROLE CHECKER & REACTION LOGIC
--------------------------------------------------------------------------------
function CheckRole()
	local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not getPlayerData then return end

	local success, result = pcall(function()
		return getPlayerData:InvokeServer()
	end)
	if not success or not result then return end

	local myRole = nil
	local roundIdentifier = ""

	for playerName, data in pairs(result) do
		roundIdentifier = roundIdentifier .. playerName .. (data.Role or "")
		if playerName == LP.Name then
			myRole = data.Role
		end
	end

	-- Update Murderer status for voting
	isMurderer = (myRole == "Murderer")

	if roundIdentifier ~= lastRoundIdentifier then
		lastRoundIdentifier = roundIdentifier
		CleanMap()
		
		if myRole then
			task.wait(0.2)
			local character = LP.Character or LP.CharacterAdded:Wait()
			CleanCharacter(character)
			local root = character:WaitForChild("HumanoidRootPart", 5)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if not root or not humanoid then return end

			if myRole == "Innocent" then
				-- Instantly reset if Innocent
				humanoid.Health = 0

			elseif myRole == "Sheriff" or myRole == "Hero" then
				-- Teleport to Platform, then instantly reset
				EnsurePlatform()
				root.CFrame = CFrame.new(100, 100, 100)
				task.wait(0.1)
				humanoid.Health = 0

			elseif myRole == "Murderer" then
				if isRestrictedUser(LP.Name) then
					-- Stay in current position and do not reset
					return
				else
					-- Non-restricted Murderer: Teleport to Platform
					EnsurePlatform()
					root.CFrame = CFrame.new(100, 100, 100)
				end
			end
		end
	end
end

RunService.RenderStepped:Connect(function()
	pcall(CheckRole)
end)

--------------------------------------------------------------------------------
-- AUTO VOTE HELPERS & CONTINUOUS LOOP
--------------------------------------------------------------------------------
local function getCharacter()
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		char = LP.CharacterAdded:Wait()
		char:WaitForChild("HumanoidRootPart", 5)
		char:WaitForChild("Humanoid", 5)
	end
	return char
end

local function findDetectorPart(votePad)
	for _, child in ipairs(votePad:GetDescendants()) do
		if child:IsA("BasePart") and (child.Name:match("^Detector") or child.Name:match("Detector")) then
			return child
		end
	end
	if votePad:IsA("BasePart") then return votePad end
	if votePad:IsA("Model") and votePad.PrimaryPart then return votePad.PrimaryPart end
	return votePad:FindFirstChildWhichIsA("BasePart", true)
end

local function checkWorkspaceMap()
	for _, mapName in ipairs(allKnownMaps) do
		local formattedName = string.gsub(mapName, "%s+", "")
		if Workspace:FindFirstChild(formattedName) then
			return formattedName
		end
	end
	return nil
end

local function findSpecificMap(targetMapName)
	local regularLobby = Workspace:FindFirstChild("RegularLobby")
	if not regularLobby then return nil end
	
	local searchFolders = { regularLobby }
	local voteIcons = regularLobby:FindFirstChild("VoteIcons")
	if voteIcons then table.insert(searchFolders, voteIcons) end
	
	for _, folder in ipairs(searchFolders) do
		for _, votePad in ipairs(folder:GetChildren()) do
			if votePad.Name:match("^VotePad") then
				local voteInfoGui = votePad:FindFirstChild("VoteInfoGui")
				local container = voteInfoGui and voteInfoGui:FindFirstChild("Container")
				local mapNameObj = container and container:FindFirstChild("MapName")
				if mapNameObj and (mapNameObj:IsA("TextLabel") or mapNameObj:IsA("TextButton") or mapNameObj:IsA("TextBox")) then
					local text = tostring(mapNameObj.Text)
					if text ~= "" then
						if string.find(string.lower(text), string.lower(targetMapName), 1, true) then
							local detectorPart = findDetectorPart(votePad)
							if detectorPart then
								return { name = targetMapName, text = text, part = detectorPart }
							end
						end
					end
				end
			end
		end
	end
	return nil
end

local function findAnyPriorityMap()
	for _, mapName in ipairs(priorityList) do
		local result = findSpecificMap(mapName)
		if result then return result end
	end
	return nil
end

local function teleportToMap(targetPart)
	if isMurderer then
		updateStatus("Murderer active - TP disabled")
		return false
	end

	local success, err = pcall(function()
		local character = getCharacter()
		if not character then return false end
		
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 then return false end
		if checkWorkspaceMap() then return false end
		
		local targetPos = targetPart.Position + Vector3.new(0, TELEPORT_DISTANCE, 0)
		root.CFrame = CFrame.new(targetPos)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		
		if RESET_DELAY > 0 then task.wait(RESET_DELAY) end
		if checkWorkspaceMap() then return false end
		
		if humanoid and humanoid.Health > 0 then humanoid.Health = 0 end
		if RESPAWN_DELAY > 0 then task.wait(RESPAWN_DELAY) end
		
		local startTime = tick()
		repeat
			task.wait(0.2)
			local newChar = LP.Character
			if newChar and newChar:FindFirstChild("HumanoidRootPart") and newChar:FindFirstChildOfClass("Humanoid") and newChar.Humanoid.Health > 0 then
				break
			end
		until tick() - startTime > 5
		
		return true
	end)
	return success and err ~= false
end

-- Endless Voting Loop until map loads in Workspace
updateStatus("Scanning VotePads...")
task.spawn(function()
	while true do
		pcall(function()
			local activeMap = checkWorkspaceMap()
			if activeMap then
				updateStatus(activeMap .. " is running")
				repeat task.wait(1) until not checkWorkspaceMap()
			else
				for i = POST_MATCH_WAIT, 1, -1 do
					if checkWorkspaceMap() then break end
					updateStatus("Waiting (" .. i .. ")")
					task.wait(1)
				end

				while not checkWorkspaceMap() do
					local currentResult = findAnyPriorityMap()
					if currentResult then
						if isMurderer then
							updateStatus("Murderer: Voting skipped")
							task.wait(1)
						else
							updateStatus("Voting: " .. currentResult.name)
							teleportToMap(currentResult.part)
						end
					else
						updateStatus("Scanning VotePads...")
						task.wait(CHECK_DELAY)
					end
				end
			end
		end)
		task.wait(0.5)
	end
end)
