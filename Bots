--------------------------------------------------------------------------------
-- MURDERER AUTOMATION LOGIC (SINGLE TELEPORT PER TARGET)
--------------------------------------------------------------------------------
local function runMurdererLogic()
	if isMurdererLoopRunning then return end
	isMurdererLoopRunning = true

	task.spawn(function()
		task.wait(5)
		local baseCFrame = CFrame.new(620, 562, 35)

		while isMurdererLoopRunning do
			local char = LP.Character
			local backpack = LP:FindFirstChild("Backpack")
			
			if not char then
				task.wait(0.1)
				continue
			end

			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")

			if not (humanoid and root and humanoid.Health > 0) then
				break
			end

			pcall(function()
				root.CFrame = baseCFrame
			end)

			local knife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
			
			if knife and hasValidMurdererTargets() then
				if backpack and knife.Parent == backpack then
					pcall(function()
						humanoid:EquipTool(knife)
					end)
					task.wait(0.05)
				end

				-- Teleport each non-whitelisted target ONCE
				for _, target in ipairs(Players:GetPlayers()) do
					if target ~= LP and not isExactWhitelisted(target) and not teleportedTargets[target] then
						local targetChar = target.Character
						if targetChar then
							local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
							local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

							if targetRoot and targetHum and targetHum.Health > 0 then
								teleportedTargets[target] = true
								pcall(function()
									targetRoot.CFrame = root.CFrame * CFrame.new(0, 0, -2)
									knife:Activate()
								end)
								task.wait(0.03)
							end
						end
					end
				end
			end

			task.wait(0.05)
		end
	end)
end

--------------------------------------------------------------------------------
-- RANDOMIZED RESET / FLING LOGIC
--------------------------------------------------------------------------------
local function touch(a, b)
	pcall(function()
		firetouchinterest(a, b, 0)
		firetouchinterest(a, b, 1)
	end)
end

local function setRootReference(root, target)
	pcall(function()
		sethiddenproperty(root, "PhysicsRepRootRef", InstanceHandle.new(target))
		sethiddenproperty(root, "PhysicsRepRootPart", target)
	end)
end

local function clearRootReference(root)
	pcall(function()
		sethiddenproperty(root, "PhysicsRepRootRef", nil)
		sethiddenproperty(root, "PhysicsRepRootPart", nil)
	end)
end

local function fullyRestoreCharacter(character, savedData)
	if not character or not savedData then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end
	humanoid.PlatformStand = false
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	rootPart.CFrame = savedData.cframe
	clearRootReference(rootPart)
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then part.CanCollide = true end
	end
end

local function resetPlayerRandom(TargetPlayer)
	if not TargetPlayer or TargetPlayer == LP then return end
	if isWhitelisted(TargetPlayer) then return end
	
	local Character = LP.Character
	if not Character then return end
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	local TCharacter = TargetPlayer.Character
	if not (Character and Humanoid and RootPart and TCharacter) then return end
	local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
	local THead = TCharacter:FindFirstChild("Head")
	if not TRootPart then return end

	local savedData = { cframe = RootPart.CFrame }
	Humanoid.PlatformStand = true
	
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Velocity = Vector3.new(0, -50000, 0)
	bv.Parent = RootPart
	
	local bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bg.P = 1000000
	bg.Parent = RootPart

	local previousDestroyHeight = Workspace.FallenPartsDestroyHeight
	Workspace.FallenPartsDestroyHeight = 0/0
	local startTime = tick()

	local randomOffset = Vector3.new(math.random(-5, 5), math.random(2, 8), math.random(-5, 5))
	local randomAngVel = Vector3.new(math.random(5000, 10000), math.random(5000, 10000), math.random(5000, 10000))

	local conn
	conn = RunService.Heartbeat:Connect(function()
		if tick() - startTime > 1 or not TargetPlayer.Character or not TRootPart.Parent then
			Workspace.FallenPartsDestroyHeight = previousDestroyHeight
			if bv.Parent then bv:Destroy() end
			if bg.Parent then bg:Destroy() end
			clearRootReference(RootPart)
			fullyRestoreCharacter(Character, savedData)
			if conn then conn:Disconnect() end
			return
		end
		if TRootPart and TRootPart.Parent then
			local targetPos = THead and THead.Position or (TRootPart.Position + randomOffset)
			RootPart.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.random() * math.pi, math.random() * math.pi, 0)
			RootPart.AssemblyLinearVelocity = Vector3.new(math.random(-500, 500), -50000, math.random(-500, 500))
			RootPart.AssemblyAngularVelocity = randomAngVel
			for i = 1, 3 do
				touch(RootPart, TRootPart)
			end
			setRootReference(RootPart, TRootPart)
		end
	end)
end

