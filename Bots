--------------------------------------------------------------------------------
-- HELPER: FETCH CURRENT ROLE DATA & WEAPON CHECKS
--------------------------------------------------------------------------------
local function getPlayerData()
	local getPlayerDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not getPlayerDataRemote then return nil, nil, "" end

	local success, result = pcall(function()
		return getPlayerDataRemote:InvokeServer()
	end)
	if not success or not result then return nil, nil, "" end

	local myRole = nil
	local murdererPlayerName = nil
	local roundIdentifier = ""

	for playerName, data in pairs(result) do
		roundIdentifier = roundIdentifier .. playerName .. (data.Role or "")
		if playerName == LP.Name then
			myRole = data.Role
		end
		if data.Role == "Murderer" then
			murdererPlayerName = playerName
		end
	end

	return myRole, murdererPlayerName, roundIdentifier
end

local function isHoldingGun()
	local char = LP.Character
	if char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function hasGunTool()
	local char = LP.Character
	local backpack = LP:FindFirstChild("Backpack")

	if isHoldingGun() then return true end
	if backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")) then
		return true
	end
	return false
end

local function hasKnifeTool()
	local char = LP.Character
	local backpack = LP:FindFirstChild("Backpack")

	if char and char:FindFirstChild("Knife") then return true end
	if backpack and backpack:FindFirstChild("Knife") then return true end
	return false
end

--------------------------------------------------------------------------------
-- CONTINUOUS GUN HOLD TIMER MONITORING
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if isHoldingGun() and not isResettingFromHold then
			gunHeldTimer = gunHeldTimer + 0.5
			if gunHeldTimer >= 5 then
				isResettingFromHold = true
				
				local myRole, murdererPlayerName = getPlayerData()
				local isLocalRestricted = isRestrictedUser(LP.Name)
				local isMurdererRestricted = murdererPlayerName and isRestrictedUser(murdererPlayerName)

				if not (isLocalRestricted or isMurdererRestricted) then
					local character = LP.Character
					if character then
						CleanCharacter(character)
						local humanoid = character:FindFirstChild("Humanoid")
						if humanoid then
							humanoid.Health = 0
						end
					end
				end
			end
		else
			gunHeldTimer = 0
		end
	end
end)

--------------------------------------------------------------------------------
-- MONITOR ALL RESTRICTED USERS STANDING STILL WHILE BOT HAS KNIFE
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if hasKnifeTool() and not isResettingFromTargetStill then
			local triggeredReset = false

			for _, targetName in ipairs(restrictedNames) do
				local targetPlayer = Players:FindFirstChild(targetName)
				if targetPlayer and targetPlayer.Character then
					local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					if targetRoot then
						local currentPos = targetRoot.Position
						local lastPos = targetLastPositions[targetName]

						if lastPos then
							-- Check if position changed less than 0.5 units (standing still)
							if (currentPos - lastPos).Magnitude < 0.5 then
								targetStillTimers[targetName] = (targetStillTimers[targetName] or 0) + 0.5
							else
								targetStillTimers[targetName] = 0
							end
						else
							targetStillTimers[targetName] = 0
						end
						targetLastPositions[targetName] = currentPos

						-- Check if this specific user stood still for 5+ seconds
						if (targetStillTimers[targetName] or 0) >= 5 then
							triggeredReset = true
							break
						end
					else
						targetStillTimers[targetName] = 0
						targetLastPositions[targetName] = nil
					end
				else
					targetStillTimers[targetName] = 0
					targetLastPositions[targetName] = nil
				end
			end

			if triggeredReset then
				isResettingFromTargetStill = true
				local character = LP.Character
				if character then
					CleanCharacter(character)
					local humanoid = character:FindFirstChild("Humanoid")
					if humanoid then
						humanoid.Health = 0
					end
				end
			end
		else
			targetStillTimers = {}
			targetLastPositions = {}
		end
	end
end)

--------------------------------------------------------------------------------
-- ROLE CHECKER & REACTION LOGIC
--------------------------------------------------------------------------------
function CheckRole()
	local myRole, murdererPlayerName, roundIdentifier = getPlayerData()
	if not myRole then return end

	if roundIdentifier ~= lastRoundIdentifier then
		lastRoundIdentifier = roundIdentifier
		CleanMap()
		
		if myRole then
			task.spawn(function()
				local isLocalRestricted = isRestrictedUser(LP.Name)
				local isMurdererRestricted = murdererPlayerName and isRestrictedUser(murdererPlayerName)

				if myRole == "Innocent" then
					-- Check if innocent picked up a dropped Gun tool
					if hasGunTool() then
						if not (isLocalRestricted or isMurdererRestricted) then
							task.wait(5)
							local character = LP.Character
							if character then
								CleanCharacter(character)
								local humanoid = character:FindFirstChild("Humanoid")
								if humanoid then
									humanoid.Health = 0
								end
							end
						end
					end
					return

				elseif myRole == "Sheriff" or myRole == "Hero" or hasGunTool() then
					if isLocalRestricted or isMurdererRestricted then
						-- Do NOT reset if local player is restricted OR if the Murderer is a restricted user
						return
					else
						-- Non-restricted Sheriff/Hero or player with Gun: Wait 5s, then reset directly
						task.wait(5)
						local character = LP.Character
						if character then
							CleanCharacter(character)
							local humanoid = character:FindFirstChild("Humanoid")
							if humanoid then
								humanoid.Health = 0
							end
						end
					end

				elseif myRole == "Murderer" then
					-- Murderer never resets automatically at round start
					return
				end
			end)
		end
	end
end

RunService.RenderStepped:Connect(function()
	pcall(CheckRole)
end)
