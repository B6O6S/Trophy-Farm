--------------------------------------------------------------------------------
-- EXACT WHITELISTED USERS STILLNESS MONITOR
--------------------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.5) do
		if tick() - scriptLoadTime > INITIAL_LOAD_DELAY and not isResettingFromTargetStill then
			if anyoneHasWeapon() then
				for name, _ in pairs(WHITELIST_EXACT) do
					local targetPlayer = Players:FindFirstChild(name)
					
					if targetPlayer and not targetHasGun(targetPlayer) then
						if targetPlayer.Character then
							local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
							if targetRoot then
								local currentPos = targetRoot.Position
								local lastPos = targetLastPositions[name]

								if lastPos then
									if (currentPos - lastPos).Magnitude < 0.5 then
										targetStillTimers[name] = (targetStillTimers[name] or 0) + 0.5
									else
										targetStillTimers[name] = 0
									end
								else
									targetStillTimers[name] = 0
									targetLastPositions[name] = currentPos
								end
								targetLastPositions[name] = currentPos

								if (targetStillTimers[name] or 0) >= 5 then
									isResettingFromTargetStill = true
									local character = LP.Character
									if character then
										local humanoid = character:FindFirstChild("Humanoid")
										if humanoid then humanoid.Health = 0 end
									end
									break
								end
							end
						end
					else
						targetStillTimers[name] = 0
						targetLastPositions[name] = nil
					end
				end
			else
				for name, _ in pairs(WHITELIST_EXACT) do
					targetStillTimers[name] = 0
					targetLastPositions[name] = nil
				end
			end
		end
	end
end)
