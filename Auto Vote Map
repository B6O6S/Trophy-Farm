end

local CHECK_DELAY = 0.5
local TELEPORT_DISTANCE = -2 
local RESET_DELAY = 0.2 
local RESPAWN_DELAY = 0
local POST_MATCH_WAIT = 10
local VOTE_DURATION = 10 

local priorityList = {
	"Manor", "House 2", "Office 3", "Hospital 3", "Bank 2", 
	"Vampire's Castle", "Mansion 2", "WorkPlace", "Hotel 2", "Farm House", 
	"Police Station", "Factory", "Bio Lab", "Research Facility", "Mil Base"
}

local allKnownMaps = {
	"Bank2", "BioLab", "Factory", "Hospital3", "Hotel2", "House2", 
	"Mansion2", "MilBase", "Office3", "PoliceStation", "ResearchFacility", 
	"Workplace", "BeachResort", "Yacht", "Pier", "Manor", "Farmhouse", 
	"Mineshaft", "BarnInfection", "VampiresCastle", "Spaceship", "Workshop", 
	"LogCabin", "TrainStation", "IceCastle", "SkiLodge", "ChristmasInItaly", "SkiVillage"
}

