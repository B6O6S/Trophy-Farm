local function shootMurd()
	local lastShotTime = 0
	while isShootMurdererActive do
		local murd = getMurd()
		if not murd or not murd.Character then break end
		
		local hum = murd.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health <= 0 then break end
		
		local hrp = murd.Character:FindFirstChild("HumanoidRootPart") or murd.Character:FindFirstChild("UpperTorso")
		if hrp then
			local now = tick()
			-- Throttle shooting to every 0.35 seconds to completely prevent spam & ping lag
			if now - lastShotTime >= 0.35 then
				lastShotTime = now
				shootMurdererInstantly(hrp, currentPingVal, currentFps)
			end
		else
			break
		end
		task.wait(0.1)
	end
	
	-- Restore default camera to local character when done shooting
	pcall(function()
		local camera = Workspace.CurrentCamera
		local localHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if localHum then
			camera.CameraSubject = localHum
		end
	end)
end

