-- ==================== ANTI-FLING IMPLEMENTATION ====================
local function SetupAntiFling()
    local LastPosition = nil
    RunService.Heartbeat:Connect(function()
        if not isAntiFlingActive then return end
        pcall(function()
            local Character = LocalPlayer.Character
            if not Character then return end
            
            local PrimaryPart = Character.PrimaryPart
            if not PrimaryPart then return end

            local linVel = PrimaryPart.AssemblyLinearVelocity.Magnitude
            local angVel = PrimaryPart.AssemblyAngularVelocity.Magnitude

            if linVel > 250 or angVel > 250 then
                PrimaryPart.AssemblyAngularVelocity = Vector3.zero
                PrimaryPart.AssemblyLinearVelocity = Vector3.zero
                if LastPosition then
                    PrimaryPart.CFrame = LastPosition
                end
            elseif linVel < 50 and angVel < 50 then
                LastPosition = PrimaryPart.CFrame
            end
        end)
    end)
end

SetupAntiFling()
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    SetupAntiFling()
end)

