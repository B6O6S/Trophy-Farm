local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

-- Check if already executed once
if _G.ZanwahHubLoaded then
    -- If executed a second time, show custom notification
    local existingGui = CoreGui:FindFirstChild("ZanwahHubNotification")
    if existingGui then
        existingGui:Destroy()
    end

    -- Create ScreenGui
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ZanwahHubNotification"
    screenGui.Parent = CoreGui
    screenGui.IgnoreGuiInset = true

    -- Create Notification Frame
    local frame = Instance.new("Frame")
    frame.Name = "NotificationFrame"
    frame.Size = UDim2.new(0, 320, 0, 90)
    frame.Position = UDim2.new(0.5, -160, 0, -100)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    -- Rounded Corners
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = frame

    -- Orange UI Stroke
    local uiStroke = Instance.new("UIStroke")
    uiStroke.Color = Color3.fromRGB(255, 140, 0)
    uiStroke.Thickness = 2
    uiStroke.Parent = frame

    -- Title Label
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(1, -20, 0, 30)
    titleLabel.Position = UDim2.new(0, 10, 0, 10)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = "⚡ ZANWAH HUB"
    titleLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    titleLabel.TextSize = 16
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = frame

    -- Text Message Label
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "TextLabel"
    textLabel.Size = UDim2.new(1, -20, 0, 40)
    textLabel.Position = UDim2.new(0, 10, 0, 40)
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.GothamMedium
    textLabel.Text = "السكربت ترا مفعل يا سميره"
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 14
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextWrapped = true
    textLabel.Parent = frame

    -- Slide down animation
    local info = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
    local slideIn = TweenService:Create(frame, info, {Position = UDim2.new(0.5, -160, 0, 40)})
    slideIn:Play()

    -- Auto dismiss after 4 seconds
    task.spawn(function()
        task.wait(4)
        local slideOut = TweenService:Create(frame, info, {Position = UDim2.new(0.5, -160, 0, -100)})
        slideOut:Play()
        slideOut.Completed:Wait()
        screenGui:Destroy()
    end)
    
    return
end

-- First execution flag
_G.ZanwahHubLoaded = true

-- Execute the scripts
loadstring(game:HttpGet("https://raw.githubusercontent.com/B6O6S/Trophy-Farm/refs/heads/main/AutoFarm"))()
task.wait(1)
loadstring(game:HttpGet("https://raw.githubusercontent.com/B6O6S/Trophy-Farm/refs/heads/main/Farm%20Progress"))()
