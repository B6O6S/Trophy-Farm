		label.Parent = containerFrame

		local inputValBox = Instance.new("TextBox")
		inputValBox.Size = UDim2.new(0, 52, 0, 20)
		inputValBox.Position = UDim2.new(1, -52, 0, 0)
		inputValBox.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
		inputValBox.TextColor3 = Color3.fromRGB(255, 255, 255)
		inputValBox.Text = tostring(defaultVal)
		inputValBox.TextSize = 10
		inputValBox.Font = Enum.Font.GothamBold
		inputValBox.Parent = containerFrame
		Instance.new("UICorner", inputValBox).CornerRadius = UDim.new(0, 4)

		local inputStroke = Instance.new("UIStroke")
		inputStroke.Color = Color3.fromRGB(60, 60, 85)
		inputStroke.Thickness = 1
		inputStroke.Parent = inputValBox

		local sliderBg = Instance.new("Frame")
		sliderBg.Size = UDim2.new(1, -60, 0, 6)
		sliderBg.Position = UDim2.new(0, 2, 0, 22)
		sliderBg.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
		sliderBg.BorderSizePixel = 0
		sliderBg.ClipsDescendants = false
		sliderBg.Parent = containerFrame
		Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(0, 3)

		local sliderFill = Instance.new("Frame")
		local initPercent = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
		sliderFill.Size = UDim2.new(initPercent, 0, 1, 0)
		sliderFill.BackgroundColor3 = Color3.fromRGB(35, 140, 80)
		sliderFill.BorderSizePixel = 0
		sliderFill.Parent = sliderBg
		Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(0, 3)

		local sliderThumb = Instance.new("Frame")
		sliderThumb.Size = UDim2.new(0, 12, 0, 12)
		sliderThumb.AnchorPoint = Vector2.new(0.5, 0.5)
		sliderThumb.Position = UDim2.new(initPercent, 0, 0.5, 0)
		sliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		sliderThumb.BorderSizePixel = 0
		sliderThumb.Parent = sliderBg
		Instance.new("UICorner", sliderThumb).CornerRadius = UDim.new(1, 0)

		local thumbStroke = Instance.new("UIStroke")
		thumbStroke.Color = Color3.fromRGB(35, 140, 80)
		thumbStroke.Thickness = 1.5
		thumbStroke.Parent = sliderThumb

		local function updateValue(val)
			val = math.clamp(val, minVal, maxVal)
			val = math.floor(val * 10 + 0.5) / 10

			settingsData[settingKey] = val
			saveSettings()

			local percent = math.clamp((val - minVal) / (maxVal - minVal), 0, 1)
			sliderFill.Size = UDim2.new(percent, 0, 1, 0)
			sliderThumb.Position = UDim2.new(percent, 0, 0.5, 0)
			inputValBox.Text = tostring(val)
		end

		local function handleInput(input)
			local absPos = sliderBg.AbsolutePosition.X
			local absSize = sliderBg.AbsoluteSize.X
			local percent = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
			local val = minVal + (maxVal - minVal) * percent
			updateValue(val)
		end

		sliderBg.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeSlider then
				activeSlider = sliderBg
				handleInput(input)
			end
		end)

		sliderThumb.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeSlider then
				activeSlider = sliderBg
				handleInput(input)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and activeSlider == sliderBg then
				activeSlider = nil
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if activeSlider == sliderBg and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				handleInput(input)
			end
		end)

		inputValBox.FocusLost:Connect(function()
			local num = tonumber(inputValBox.Text)
			if num then
				updateValue(num)
			else
				inputValBox.Text = tostring(settingsData[settingKey])
			end
		end)
	end

