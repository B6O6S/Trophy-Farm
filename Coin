-- MAIN HEARTBEAT AUTOMATION LOOP
--------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	local character, rootPart, humanoid = getCharacterParts()
	
	-- 1. COIN AURA IMPLEMENTATION
	if character and rootPart then
		local radius = (radiusInput and tonumber(radiusInput.Text)) or settingsData.AuraRadius
		local rootPos = rootPart.Position
		local containers = getCoinContainers()
		local coinParts = getCoinParts(containers)
		
		for _, part in ipairs(coinParts) do
			if (rootPos - part.Position).Magnitude <= radius then
				touch(rootPart, part)
			end
		end
	end

	if not isFarmingActive then return end
	if not character or not rootPart or not humanoid or humanoid.Health > 0 == false then
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then part.CanCollide = false end
	end

	local bv = rootPart:FindFirstChild("SmoothFarmVelocity")
	if not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "SmoothFarmVelocity"
		bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bv.P = 20000
		bv.Parent = rootPart
	end

	-- Scan Active Map Coins
	local containers = getCoinContainers()
	local allDescendants = {}
	for _, container in ipairs(containers) do
		for _, desc in ipairs(container:GetDescendants()) do
			if isTargetCoin(desc) then table.insert(allDescendants, desc) end
		end
	end

	local unvisitedCount = 0
	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) and not visitedCoins[part] then unvisitedCount = unvisitedCount + 1 end
	end
	if unvisitedCount == 0 then visitedCoins = {} end

	local activeCoinsExist = false
	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) then
			activeCoinsExist = true
			break
		end
	end

	-- ============ COIN DETECTION & "GONE TO FULL" LOGIC ============
	if activeCoinsExist then
		hadCoinsBefore = true
		weaponWaitTimer = 0
		if timerLabel then timerLabel.Text = "Farming Coins..." end
	else
		if hadCoinsBefore then
			isBagFull = true
			if timerLabel then timerLabel.Text = "Coins Gone (Bag Full)" end
		else
			if hasWeapon() and not isBagFull then
				if not timerPlayedThisLife then
					weaponWaitTimer = weaponWaitTimer + dt
					local remainingSeconds = math.max(0, 11 - weaponWaitTimer)
					
					if statusLabel then statusLabel.Text = "Status: Checking Inventory..." end
					if timerLabel then timerLabel.Text = string.format("%.1fs remaining", remainingSeconds) end

					if weaponWaitTimer >= 15 then
						isBagFull = true
						timerPlayedThisLife = true
						if timerLabel then timerLabel.Text = "11.0s Complete (Bag Full)" end
					end
				else
					isBagFull = true
					if timerLabel then timerLabel.Text = "Bag Full (Completed)" end
				end
			elseif not hasWeapon() and not activeCoinsExist then
				if statusLabel then statusLabel.Text = "Status: Waiting for Coins..." end
				if timerLabel then timerLabel.Text = "00.0s (No Weapon)" end
			end
		end
	end

	-- ============ STRICT SKY PLATFORM TELEPORT ============
	if isBagFull then
		if statusLabel then statusLabel.Text = "Status: Bag Full! Resting on Platform..." end
		visitedCoins = {}
		if currentTargetAnchor then currentTargetAnchor:Destroy() currentTargetAnchor = nil end
		bv.Velocity = Vector3.zero
		
		if not hasTeleportedToPlatform or rootPart.Position.Y < 4995 then
			rootPart.CFrame = CFrame.new(0, 5005, 0)
			hasTeleportedToPlatform = true
		end

		-- Trigger Combat Actions once rested on platform if bag is full
		if hasKnife() and isAutoKillAllActive then
			pcall(killAll)
		elseif hasGun() and isShootMurdererActive then
			pcall(function()
				local murd = getMurd()
				if murd and murd.Character and murd.Character:FindFirstChildOfClass("Humanoid") then
					if murd.Character.Humanoid.Health > 0 then
						shootMurd()
						task.wait(0.5)
						unequipGun()
					end
				end
			end)
		end

		return
	else
		hasTeleportedToPlatform = false
	end

	-- ============ ACTIVE COIN FARMING MOVEMENT ============
	local closestPart, closestCF = nil, nil
	local shortestDistance = math.huge
	local rootPos = rootPart.Position

	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) and not visitedCoins[part] then
			local cf = getExactCoinCFrame(part)
			if cf then
				local heightOffset = (heightInput and tonumber(heightInput.Text)) or settingsData.HeightOffset
				local targetPosWithOffset = cf.Position + Vector3.new(0, heightOffset, 0)
				local distanceToTarget = (rootPos - targetPosWithOffset).Magnitude

				if distanceToTarget < shortestDistance then
					shortestDistance = distanceToTarget
					closestPart = part
					closestCF = cf
				end
			end
		end
	end

	if closestPart and closestCF then
		if statusLabel then statusLabel.Text = "Status: Fluid Farming Coins..." end
		local exactCoinPos = updateTargetAnchor(closestCF)
		local speed = (speedInput and tonumber(speedInput.Text)) or settingsData.Speed
		local heightOffset = (heightInput and tonumber(heightInput.Text)) or settingsData.HeightOffset
		local finalTargetPos = exactCoinPos + Vector3.new(0, heightOffset, 0)

		humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)

		local targetPosition = finalTargetPos
		local currentPosition = rootPart.Position
		local distance = (targetPosition - currentPosition).Magnitude

		if distance >= 500 then
			rootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(math.rad(90), 0, 0)
			bv.Velocity = Vector3.zero
		else
			local direction = targetPosition - currentPosition
			bv.Velocity = direction.Unit * speed
			rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(math.rad(90), 0, 0)

			if distance <= 2.5 then
				visitedCoins[closestPart] = true
			end
		end
	else
		if currentTargetAnchor then currentTargetAnchor:Destroy() currentTargetAnchor = nil end
		bv.Velocity = Vector3.zero
	end
end)
