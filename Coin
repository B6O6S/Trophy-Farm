		sessionCoinsLabel.Text = string.format("Session Coins: %d", coinsCollectedSession)
	end

	local containers = getCoinContainers()
	local allDescendants = {}
	for _, container in ipairs(containers) do
		for _, desc in ipairs(container:GetDescendants()) do
			if isTargetCoin(desc) then table.insert(allDescendants, desc) end
		end
	end

	if isShowCoinsActive then
		local activeCoinMap = {}
		for _, part in ipairs(allDescendants) do
			if not isCoinFading(part) then
				activeCoinMap[part] = true
				if not coinHighlights[part] then
					local hl = Instance.new("Highlight")
					hl.Name = "CoinEspHighlight"
					hl.Adornee = part
					hl.FillTransparency = 0.3
					hl.OutlineTransparency = 1
					
					local coinColor = Color3.fromRGB(255, 215, 0)
					if part:IsA("BasePart") then
						coinColor = part.Color
					elseif part:IsA("Model") then
						local bp = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
						if bp then coinColor = bp.Color end
					end
					hl.FillColor = coinColor
					hl.Parent = part
					coinHighlights[part] = hl
				else
					local bp = part:IsA("BasePart") and part or (part:IsA("Model") and (part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)))
					if bp and coinHighlights[part] then
						coinHighlights[part].FillColor = bp.Color
					end
				end
			end
		end
		for part, hl in pairs(coinHighlights) do
			if not activeCoinMap[part] or not part.Parent or isCoinFading(part) then
				if hl then hl:Destroy() end
				coinHighlights[part] = nil
			end
		end
	else
		if next(coinHighlights) then
			for _, hl in pairs(coinHighlights) do
				if hl then hl:Destroy() end
			end
			coinHighlights = {}
		end
	end

	if character and rootPart and isFarmingActive and not isBagFull then
		local radius = (radiusInput and tonumber(radiusInput.Text)) or settingsData.AuraRadius
		local rootPos = rootPart.Position
		local coinParts = getCoinParts(containers)
		
		for coinObj, info in pairs(trackedPickupCoins) do
			if not info.picked then
				if isCoinFading(coinObj) or not coinObj.Parent then
					info.picked = true
					coinsCollectedSession = coinsCollectedSession + 1
					coinsThisSpawn = coinsThisSpawn + 1
					
					if coinsThisSpawn >= BAG_MAX_COINS then
						isBagFull = true
					end
				end
			end
		end

		for _, part in ipairs(coinParts) do
			local dist = (rootPos - part.Position).Magnitude
			if dist <= radius then
				touch(rootPart, part)
				if dist <= 3.5 and not trackedPickupCoins[part] then
					trackedPickupCoins[part] = { touchedAt = tick(), picked = false }
				end
			end
		end
	end

	if not isFarmingActive then return end
	if not character or not rootPart or not humanoid or humanoid.Health > 0 == false then
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then part.CanCollide = false end
	end

	local bv = rootPart:FindFirstChild("SmoothFarmVelocity")
	if not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "SmoothFarmVelocity"
		bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bv.P = 25000
		bv.Parent = rootPart
	end

	local unvisitedCount = 0
	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) and not visitedCoins[part] then unvisitedCount = unvisitedCount + 1 end
	end
	if unvisitedCount == 0 then visitedCoins = {} end

	if hasWeapon() and not isBagFull and not hasTriggeredWeaponTimer then
		if #allDescendants > 0 then
			foundCoinsMidTimer = true
		else
			weaponTimer = weaponTimer + dt
			if weaponTimer >= TIMER_THRESHOLD then
				isBagFull = true
				hasTriggeredWeaponTimer = true
			end
		end
	end

	if isBagFull then
		visitedCoins = {}
		if currentTargetAnchor then currentTargetAnchor:Destroy() currentTargetAnchor = nil end
		
		if not hasTeleportedToSafeZone then
			isScriptTeleporting = true
			rootPart.Anchored = false
			if rootPart:FindFirstChild("SmoothFarmVelocity") then
				rootPart.SmoothFarmVelocity:Destroy()
			end

			if humanoid then
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end

			-- Teleport unanchored to safe zone smoothly
			rootPart.Anchored = false
			rootPart.CFrame = CFrame.new(610, 562, 60)
			hasTeleportedToSafeZone = true
			lastPosition = rootPart.Position
			task.delay(0.2, function() isScriptTeleporting = false end)
		end

		safeZoneTimer = safeZoneTimer + dt
		local remainingSafeTime = math.max(0, math.ceil(HOLD_SAFEZONE_TIME - safeZoneTimer))
		if statusLabel then 
			statusLabel.Text = string.format("Status: Holding Gun (%ds) -> Reset", remainingSafeTime) 
		end

		if hasKnife() and isAutoKillAllActive then
			pcall(killAll)
		elseif hasGun() and isShootMurdererActive then
			pcall(shootMurd)
		end

		if safeZoneTimer >= HOLD_SAFEZONE_TIME and not isResetting then
			isResetting = true
			if humanoid and humanoid.Health > 0 then
				humanoid.Health = 0
			end
		end

		return
	else
		hasTeleportedToSafeZone = false
	end

	local closestPart, closestCF = nil, nil
	local shortestDistance = math.huge
	local rootPos = rootPart.Position

	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) and not visitedCoins[part] then
			local cf = getExactCoinCFrame(part)
			if cf then
				local heightOffset = (heightInput and tonumber(heightInput.Text)) or settingsData.HeightOffset
				local targetPosWithOffset = cf.Position + Vector3.new(0, heightOffset, 0)
				local distanceToTarget = (rootPos - targetPosWithOffset).Magnitude

				if distanceToTarget < shortestDistance then
					shortestDistance = distanceToTarget
					closestPart = part
					closestCF = cf
				end
			end
		end
	end

	if closestPart and closestCF then
		rootPart.Anchored = false
		isScriptTeleporting = false

		if statusLabel then 
			if hasWeapon() and not hasTriggeredWeaponTimer then
				statusLabel.Text = string.format("Status: Farming W/ Weapon (%d/50)...", coinsThisSpawn)
			else
				statusLabel.Text = string.format("Status: Farming (%d/50)...", coinsThisSpawn)
			end
		end

		local exactCoinPos = updateTargetAnchor(closestCF)
		local speed = (speedInput and tonumber(speedInput.Text)) or settingsData.Speed
		local heightOffset = (heightInput and tonumber(heightInput.Text)) or settingsData.HeightOffset
		local finalTargetPos = exactCoinPos + Vector3.new(0, heightOffset, 0)

		humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)

		local targetPosition = finalTargetPos
		local currentPosition = rootPart.Position
		local distance = (targetPosition - currentPosition).Magnitude

		if distance >= 500 then
			isScriptTeleporting = true
			rootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(math.rad(90), 0, 0)
			lastPosition = rootPart.Position
			bv.Velocity = Vector3.zero
			task.delay(0.2, function() isScriptTeleporting = false end)
		else
			local direction = targetPosition - currentPosition
			bv.Velocity = direction.Unit * speed
			
			-- Stable anti-glitch CFrame assignment for flat laying position
			local currentPos = rootPart.Position
			rootPart.CFrame = CFrame.new(currentPos.X, currentPos.Y, currentPos.Z) * CFrame.Angles(math.rad(90), 0, 0)
			
			lastPosition = rootPart.Position

			if distance <= 2.5 then
				visitedCoins[closestPart] = true
			end
		end
	else
		if currentTargetAnchor then currentTargetAnchor:Destroy() currentTargetAnchor = nil end
		bv.Velocity = Vector3.zero
		rootPart.Anchored = false

		if isCurrentlyVoting then
			lastPosition = rootPart.Position
			if statusLabel then statusLabel.Text = "Status: Auto Voting..." end
		else
			lastPosition = rootPart.Position

			if hasWeapon() and foundCoinsMidTimer and not hasTriggeredWeaponTimer then
				isBagFull = true
				hasTriggeredWeaponTimer = true
			elseif hasWeapon() and not hasTriggeredWeaponTimer then
				local remaining = math.max(0, math.ceil(TIMER_THRESHOLD - weaponTimer))
				if statusLabel then statusLabel.Text = string.format("Status: Waiting Coins (%ds)...", remaining) end
			else
				if statusLabel then statusLabel.Text = string.format("Status: Waiting for Coins... (%d/50)", coinsThisSpawn) end
			end
		end
	end
end)
