end

-- Function to add a Fill-Only Highlight matched to the Coin's color
local function addHighlight(target)
	if target and (target:IsA("BasePart") or target:IsA("Model")) then
		if not target:FindFirstChild("CoinHighlight") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "CoinHighlight"
			
			-- Fill-only settings (disables outline)
			highlight.OutlineTransparency = 1
			highlight.FillTransparency = 0.35
			
			-- Match color to the coin
			local function updateColor()
				if target:IsA("BasePart") then
					highlight.FillColor = target.Color
				elseif target:IsA("Model") then
					local primary = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
					if primary then
						highlight.FillColor = primary.Color
					else
						highlight.FillColor = Color3.fromRGB(255, 215, 0) -- Fallback gold
					end
				end
			end
			
			updateColor()
			
			if target:IsA("BasePart") then
				target:GetPropertyChangedSignal("Color"):Connect(function()
					highlight.FillColor = target.Color
				end)
			end
			
			highlight.Parent = target
		end
	end
end

-- Check if an object is a target coin (Coin_Server or CoinVisual)
local function isTargetCoin(desc)
	return desc.Name == "Coin_Server" or desc.Name == "CoinVisual"
end

-- Check if a coin is fading/transparent (collected)
local function isCoinFading(part)
	if not part or not part.Parent then return true end
	if part:IsA("BasePart") then
		return part.Transparency > 0.1
	elseif part:IsA("Model") then
		local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
		return primary and primary.Transparency > 0.1
	end
	return false
end

-- Scan and highlight ONLY target coins in any map's CoinContainer
local function highlightCoins()
	for _, map in ipairs(Workspace:GetChildren()) do
		local container = map:FindFirstChild("CoinContainer")
		if container then
			for _, desc in ipairs(container:GetDescendants()) do
				if isTargetCoin(desc) then
					addHighlight(desc)
				end
			end
		end
	end
end

highlightCoins()

-- Watch for newly added target coins across any map
Workspace.DescendantAdded:Connect(function(descendant)
	if isTargetCoin(descendant) then
		task.wait(0.1)
		addHighlight(descendant)
	end
end)

