				headerFpsLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
			elseif currentFps >= 30 then
				headerFpsLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
			else
				headerFpsLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			end
		end

		if headerPingLabel then
			local pingVal = 0
			pcall(function()
				pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
			headerPingLabel.Text = pingVal .. "ms"
			if pingVal <= 150 then
				headerPingLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
			elseif pingVal <= 199 then
				headerPingLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
			else
				headerPingLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			end
		end
	end

	-- Force CoinVisual Y-Rotation to 0 across any map's CoinContainer when Optimized Coins is ON
	if isOptimizedCoinsActive then
		pcall(function()
			for _, map in ipairs(Workspace:GetChildren()) do
				local container = map:FindFirstChild("CoinContainer")
				if container then
					for _, coinServer in ipairs(container:GetChildren()) do
						local coinVisual = coinServer:FindFirstChild("CoinVisual")
						if coinVisual then
							local targetPart = nil
							if coinVisual:IsA("BasePart") then
								targetPart = coinVisual
							elseif coinVisual:IsA("Model") then
								targetPart = coinVisual.PrimaryPart or coinVisual:FindFirstChildWhichIsA("BasePart", true)
							end
							
							if targetPart then
								local pos = targetPart.Position
								local _, currentYRot, _ = targetPart.CFrame:ToEulerAnglesYXZ()
								if math.abs(currentYRot) > 0.001 then
									targetPart.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, 0)
								end
							end
						end
					end
				end
			end
		end)
	end
end)

