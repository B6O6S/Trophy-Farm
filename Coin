-- ==================== FPS BOOSTER ENGINE (AGGRESSIVE & REAL-TIME) ====================
local lightingConnection = nil
local workspaceConnection = nil

local function isUnwantedEffect(obj)
	return obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or 
	       obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or 
	       obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("PostEffect") or 
	       obj:IsA("Atmosphere") or obj:IsA("Clouds") or obj:IsA("Sky") or
	       obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect") or
	       obj:IsA("DepthOfFieldEffect") or obj:IsA("SunRaysEffect")
end

local function applyFpsBoost(enable)
	pcall(function()
		if enable then
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			Lighting.Technology = Enum.Technology.Compatibility
			Lighting.ClockTime = 0
			
			for _, obj in ipairs(Lighting:GetChildren()) do
				obj:Destroy()
			end

			for _, v in ipairs(Workspace:GetDescendants()) do
				if isUnwantedEffect(v) then
					v:Destroy()
				end
			end

			for _, p in ipairs(Players:GetPlayers()) do
				if p.Character then
					for _, acc in ipairs(p.Character:GetChildren()) do
						if acc:IsA("Accessory") or acc:IsA("Hat") then
							acc:Destroy()
						end
					end
				end
			end

			local terrain = Workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				terrain.WaterWaveSize = 0
				terrain.WaterWaveSpeed = 0
				terrain.WaterReflectance = 0
				terrain.WaterTransparency = 0
			end

			if not lightingConnection then
				lightingConnection = Lighting.ChildAdded:Connect(function(child)
					if isFpsBoosterActive then
						task.defer(function()
							if child and child.Parent then child:Destroy() end
						end)
					end
				end)
			end

			if not workspaceConnection then
				workspaceConnection = Workspace.DescendantAdded:Connect(function(descendant)
					if isFpsBoosterActive and isUnwantedEffect(descendant) then
						task.defer(function()
							if descendant and descendant.Parent then descendant:Destroy() end
						end)
					end
				end)
			end
		else
			Lighting.ClockTime = 14
			if lightingConnection then
				lightingConnection:Disconnect()
				lightingConnection = nil
			end
			if workspaceConnection then
				workspaceConnection:Disconnect()
				workspaceConnection = nil
			end
		end
	end)
end

Players.PlayerAdded:Connect(function(plr)
