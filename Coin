-- Helper Functions
local function getCharacterParts()
	local character = player.Character
	if not character then return nil, nil, nil end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	return character, rootPart, humanoid
end

local function touch(a, b)
	pcall(function()
		firetouchinterest(a, b, 0)
		firetouchinterest(a, b, 1)
	end)
end

-- Helper to extract the exact CFrame of the coin object
local function getExactCoinCFrame(coinObj)
	if coinObj and coinObj.Parent then
		if coinObj:IsA("BasePart") then
			return coinObj.CFrame
		elseif coinObj:IsA("Model") then
			if coinObj.PrimaryPart then
				return coinObj.PrimaryPart.CFrame
			else
				local part = coinObj:FindFirstChildWhichIsA("BasePart", true)
				if part then
					return part.CFrame
				end
			end
		end
	end
	return nil
end

-- Helper to create or move the target anchor part to the exact CFrame
local function updateTargetAnchor(cframe)
	if not currentTargetAnchor or not currentTargetAnchor.Parent then
		currentTargetAnchor = Instance.new("Part")
		currentTargetAnchor.Name = "TargetCoinAnchor"
		currentTargetAnchor.Size = Vector3.new(1, 1, 1)
		currentTargetAnchor.Transparency = 1 -- Invisible
		currentTargetAnchor.CanCollide = false
		currentTargetAnchor.Anchored = true
		currentTargetAnchor.Parent = Workspace
	end
	currentTargetAnchor.CFrame = cframe
	return currentTargetAnchor.Position
end

-- Container & Coin Part Functions
local function getCoinContainers()
	local containers = {}
	for _, map in ipairs(Workspace:GetChildren()) do
		local container = map:FindFirstChild("CoinContainer")
		if container then
			table.insert(containers, container)
		end
	end
	return containers
end

local function getCoinParts(containers)
	local parts = {}
	for _, container in ipairs(containers) do
		for _, descendant in ipairs(container:GetDescendants()) do
			if isTargetCoin(descendant) then
				if descendant:IsA("BasePart") and descendant:FindFirstChild("TouchInterest") then
					table.insert(parts, descendant)
				elseif descendant:IsA("Model") then
					local part = descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true)
					if part and part:FindFirstChild("TouchInterest") then
						table.insert(parts, part)
					end
				end
			end
		end
	end
	return parts
end

