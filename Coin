--------------------------------------------------------
-- ADVANCED PREDICTIVE SHOOTING & TARGETING
--------------------------------------------------------
local motionPart, motionPosition, motionTime
local measuredVelocity = Vector3.zero

local function sampleMotion(part)
	local now = os.clock()
	if motionPart == part and motionPosition and motionTime then
		local delta = now - motionTime
		if delta >= 0.008 and delta <= 0.5 then
			local sampled = (part.Position - motionPosition) / delta
			if sampled.Magnitude < 300 then
				measuredVelocity = measuredVelocity:Lerp(sampled, 0.4)
			end
		end
	else
		measuredVelocity = part.AssemblyLinearVelocity
	end
	motionPart = part
	motionPosition = part.Position
	motionTime = now
end

local function calculateTravelAim(part, currentPing, currentFps)
	sampleMotion(part)
	local assembly = part.AssemblyLinearVelocity
	
	if assembly.Magnitude > 32 then
		assembly = assembly.Unit * 32
	end
	
	local velocity = assembly:Lerp(measuredVelocity, 0.35)
	
	local lead = (currentPing * 0.95) + (1 / math.max(currentFps, 30)) * 0.45
	lead = math.clamp(lead, 0.02, 0.15)
	
	local predictedVelocity = Vector3.new(velocity.X, velocity.Y * 0.3, velocity.Z)
	return part.Position + (predictedVelocity * lead)
end

local function findGunRemote()
	local character = localPlayer.Character
	local gun = character and character:FindFirstChild("Gun")
	if not gun then
		local backpack = localPlayer:FindFirstChildOfClass("Backpack")
		gun = backpack and backpack:FindFirstChild("Gun")
	end
	if gun then
		for _, obj in ipairs(gun:GetDescendants()) do
			if obj:IsA("RemoteEvent") then return obj end
		end
	end
	local cs = ReplicatedStorage:FindFirstChild("ClientServices")
	local ws = cs and cs:FindFirstChild("WeaponService")
	local gf = ws and ws:FindFirstChild("GunFired")
	if gf and gf:IsA("RemoteEvent") then return gf end
	return nil
end

local function shootMurdererInstantly(targetPart, murdPlayer, currentPing, currentFps)
	local success = false

	pcall(function()
		local camera = Workspace.CurrentCamera
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		local backpack = localPlayer:FindFirstChildOfClass("Backpack")

		if not targetPart or not camera or not character or not rootPart then return end

		local gun = character:FindFirstChild("Gun") or character:FindFirstChild("Revolver")
		if not gun and backpack then
			gun = backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")
		end

		if not gun then return end

		if gun.Parent == backpack and humanoid then
			humanoid:EquipTool(gun)
		end

		isScriptTeleporting = true
		rootPart.Anchored = false
		
		rootPart.CFrame = CFrame.new(550, 200 + 2.5, 38)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		task.delay(0.2, function() isScriptTeleporting = false end)

		if hasGun() and murdPlayer and murdPlayer.Character then
			local murdHum = murdPlayer.Character:FindFirstChildOfClass("Humanoid")
			if murdHum then
				camera.CameraSubject = murdHum
			end
		end

		local remote = findGunRemote()
		if not remote then return end

		local aim = calculateTravelAim(targetPart, currentPing, currentFps)
		local origin = camera.CFrame.Position

		remote:FireServer(CFrame.lookAt(origin, aim), CFrame.new(aim))
		success = true
	end)

	return success
end

