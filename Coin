local function getCharacterParts()
	local character = LocalPlayer.Character
	if not character then return nil, nil, nil end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	return character, rootPart, humanoid
end

local function getExactCoinCFrame(coinObj)
	if coinObj and coinObj.Parent then
		if coinObj:IsA("BasePart") then
			return coinObj.CFrame
		elseif coinObj:IsA("Model") then
			if coinObj.PrimaryPart then
				return coinObj.PrimaryPart.CFrame
			else
				local part = coinObj:FindFirstChildWhichIsA("BasePart", true)
				if part then return part.CFrame end
			end
		end
	end
	return nil
end

local function updateTargetAnchor(cframe)
	if not currentTargetAnchor or not currentTargetAnchor.Parent then
		currentTargetAnchor = Instance.new("Part")
		currentTargetAnchor.Name = "TargetCoinAnchor"
		currentTargetAnchor.Size = Vector3.new(1, 1, 1)
		currentTargetAnchor.Transparency = 1
		currentTargetAnchor.CanCollide = false
		currentTargetAnchor.Anchored = true
		currentTargetAnchor.Parent = Workspace
	end
	currentTargetAnchor.CFrame = cframe
	return currentTargetAnchor.Position
end

local function getMurd()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local bp = plr:FindFirstChild("Backpack")
			local char = plr.Character
			if (bp and bp:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
				return plr
			end
		end
	end
	return nil
end

