-- Instant Auto-Rejoin On Kick
local function attemptRejoin()
	if not isAutoRejoinActive then return end
	task.spawn(function()
		while isAutoRejoinActive do
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
			end)
			task.wait(1)
		end
	end)
end

local function setupAutoRejoin()
	GuiService.ErrorMessageChanged:Connect(function()
		local errorMessage = GuiService:GetErrorMessage()
		if errorMessage and errorMessage ~= "" then
			attemptRejoin()
		end
	end)

	pcall(function()
		local coreGui = game:GetService("CoreGui")
		coreGui.ChildAdded:Connect(function(child)
			if child.Name == "RobloxPromptDialog" then
				attemptRejoin()
			end
		end)
	end)
end

setupAutoRejoin()

-- ==================== FPS BOOSTER ENGINE ====================
local function applyFpsBoost(enable)
	pcall(function()
		if enable then
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			Lighting.Technology = Enum.Technology.Compatibility
			
			for _, obj in ipairs(Lighting:GetChildren()) do
				if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") or obj:IsA("Sky") then
					obj.Enabled = false
				end
			end

			for _, v in ipairs(Workspace:GetDescendants()) do
				if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
					v:Destroy()
				elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
					v:Destroy()
				end
			end

			for _, p in ipairs(Players:GetPlayers()) do
				if p.Character then
					for _, acc in ipairs(p.Character:GetChildren()) do
						if acc:IsA("Accessory") or acc:IsA("Hat") then
							acc:Destroy()
						end
					end
				end
			end

			local terrain = Workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				terrain.WaterWaveSize = 0
				terrain.WaterWaveSpeed = 0
				terrain.WaterReflectance = 0
				terrain.WaterTransparency = 0
			end
		end
	end)
end

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function(char)
		if isFpsBoosterActive then
			task.wait(1)
			pcall(function()
				for _, acc in ipairs(char:GetChildren()) do
					if acc:IsA("Accessory") or acc:IsA("Hat") then
						acc:Destroy()
					end
				end
			end)
		end
	end)
end)

-- ==================== COIN AURA METHODS ====================
local function touch(a, b)
	pcall(function()
		firetouchinterest(a, b, 0)
		firetouchinterest(a, b, 1)
	end)
end

local function getCoinContainers()
	local containers = {}
	for _, map in ipairs(Workspace:GetChildren()) do
		local container = map:FindFirstChild("CoinContainer")
		if container then
			table.insert(containers, container)
		end
	end
	return containers
end

local function getCoinParts(containers)
	local parts = {}
	for _, container in ipairs(containers) do
		for _, descendant in ipairs(container:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant:FindFirstChild("TouchInterest") then
				table.insert(parts, descendant)
			end
		end
	end
	return parts
end

local function isTargetCoin(desc)
	return desc.Name == "Coin_Server" or desc.Name == "CoinVisual"
end

local function isCoinFading(part)
	if not part or not part.Parent then return true end
	if part:IsA("BasePart") then
		return part.Transparency > 0.1
	elseif part:IsA("Model") then
		local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
		return primary and primary.Transparency > 0.1
	end
	return false
end

-- Tool & Weapon Identification
local function getGun()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Gun") then return char.Gun end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Gun") then return bp.Gun end
	if char and char:FindFirstChild("Revolver") then return char.Revolver end
	if bp and bp:FindFirstChild("Revolver") then return bp.Revolver end
end

local function hasGun()
	return getGun() ~= nil
end

local function getKnife()
	local char = LocalPlayer.Character
	if char then
		local k = char:FindFirstChild("Knife")
		if k then return k end
	end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		local k = bp:FindFirstChild("Knife")
		if k then return k end
	end
	return nil
end

local function hasKnife()
	return getKnife() ~= nil
end

