	local function updateCandyUI(amount, maximum)
		maximum = tonumber(maximum) or maxBagCapacity
		amount = math.clamp(tonumber(amount) or 0, 0, maximum)
		
		if amount > 0 and not roundTimerStartTime and not isBagFull then
			roundTimerStartTime = tick()
		end

		local elapsed = 0
		if finalRoundDuration then
			elapsed = finalRoundDuration
		elseif roundTimerStartTime then
			elapsed = math.floor(tick() - roundTimerStartTime)
		end

		roundTimerLabel.Text = string.format("Time: %ds", elapsed)
		
		if isBagFull or amount >= maximum then
			candiesCountInsideLabel.Text = "Max"
			bar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		else
			candiesCountInsideLabel.Text = amount .. " / " .. maximum
			bar.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
		end
		
		bar:TweenSize(
			UDim2.new(amount / math.max(maximum, 1), 0, 1, 0),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			0.2,
			true
		)
	end

