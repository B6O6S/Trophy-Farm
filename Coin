-- AUTO FLING MURDERER ROUTINE
--------------------------------------------------------
local function flingMurdererRoutine()
	if not isAutoFlingMurdererActive or not isBagFull then return end
	local murd = getMurd()
	if not murd or not murd.Character then return end

	local mRoot = murd.Character:FindFirstChild("HumanoidRootPart")
	local char = localPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not mRoot or not rootPart or not humanoid then return end

	if hasGun() then
		shootMurdererInstantly(mRoot, murd, currentPingVal, currentFps)
		return
	end

	isScriptTeleporting = true
	humanoid.PlatformStand = true

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Velocity = Vector3.new(0, 30000, 0)
	bv.Parent = rootPart

	local startTime = tick()
	while isAutoFlingMurdererActive and isBagFull and tick() - startTime < 0.8 and murd.Character and mRoot and rootPart do
		rootPart.CFrame = mRoot.CFrame * CFrame.new(0, 1, 0)
		rootPart.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
		task.wait()
	end

	if bv.Parent then bv:Destroy() end
	humanoid.PlatformStand = false
	pcall(function()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		rootPart.CFrame = CFrame.new(550, 200 + 2.5, 38)
	end)
	task.delay(0.2, function() isScriptTeleporting = false end)
end

