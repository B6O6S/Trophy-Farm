local function getCoinContainers()
	local containers = {}
	for _, map in ipairs(Workspace:GetChildren()) do
		local container = map:FindFirstChild("CoinContainer")
		if container then
			table.insert(containers, container)
		end
	end
	return containers
end

local function getCoinParts(containers)
	local parts = {}
	for _, container in ipairs(containers) do
		for _, descendant in ipairs(container:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant:FindFirstChild("TouchInterest") then
				table.insert(parts, descendant)
			end
		end
	end
	return parts
end

-- Highlight Function
local function addHighlight(target)
	if target and (target:IsA("BasePart") or target:IsA("Model")) then
		if not target:FindFirstChild("CoinHighlight") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "CoinHighlight"
			highlight.OutlineTransparency = 1
			highlight.FillTransparency = 0.35
			
			local function updateColor()
				if target:IsA("BasePart") then
					highlight.FillColor = target.Color
				elseif target:IsA("Model") then
					local primary = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
					if primary then
						highlight.FillColor = primary.Color
					else
						highlight.FillColor = Color3.fromRGB(255, 215, 0)
					end
				end
			end
			
			updateColor()
			
			if target:IsA("BasePart") then
				target:GetPropertyChangedSignal("Color"):Connect(function()
					highlight.FillColor = target.Color
				end)
			end
			
			highlight.Parent = target
		end
	end
end

local function isTargetCoin(desc)
	return desc.Name == "Coin_Server" or desc.Name == "CoinVisual"
end

local function isCoinFading(part)
	if not part or not part.Parent then return true end
	if part:IsA("BasePart") then
		return part.Transparency > 0.1
	elseif part:IsA("Model") then
		local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
		return primary and primary.Transparency > 0.1
	end
	return false
end

-- Tool & Weapon Identification
local function getGun()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Gun") then return char.Gun end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Gun") then return bp.Gun end
	if char and char:FindFirstChild("Revolver") then return char.Revolver end
	if bp and bp:FindFirstChild("Revolver") then return bp.Revolver end
end

local function hasGun()
	return getGun() ~= nil
end

local function getKnife()
	local char = LocalPlayer.Character
	if char then
		local k = char:FindFirstChild("Knife")
		if k then return k end
	end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		local k = bp:FindFirstChild("Knife")
		if k then return k end
	end
	return nil
end

local function hasKnife()
	return getKnife() ~= nil
end

local function hasWeapon()
	return hasKnife() or hasGun()
end

