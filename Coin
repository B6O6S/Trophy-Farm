--------------------------------------------------------
-- REQUESTED AUTO FIRE ENGINE & RENDERSTEPPED LOOP
--------------------------------------------------------
local function performAutoFire(mousePos)
	pcall(function()
		VirtualUser:Button1Down(mousePos)
		VirtualUser:Button1Up(mousePos)
	end)
	
	local character = LocalPlayer.Character
	if character then
		local tool = character:FindFirstChildOfClass("Tool")
		if tool then
			tool:Activate()
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	-- Realtime FPS & Ping Calculation with Color Thresholds
	frameCount = frameCount + 1
	if tick() - lastFpsUpdate >= 1 then
		currentFps = math.floor(frameCount / (tick() - lastFpsUpdate))
		frameCount = 0
		lastFpsUpdate = tick()
		
		-- Update FPS Header & Color
		if headerFpsLabel then
			headerFpsLabel.Text = currentFps .. " FPS"
			if currentFps >= 50 then
				headerFpsLabel.TextColor3 = Color3.fromRGB(0, 255, 120) -- Green
			elseif currentFps >= 30 then
				headerFpsLabel.TextColor3 = Color3.fromRGB(255, 140, 0)  -- Orange
			else
				headerFpsLabel.TextColor3 = Color3.fromRGB(255, 50, 50)   -- Red
			end
		end

		-- Update Ping Header & Color
		if headerPingLabel then
			local pingVal = 0
			pcall(function()
				pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
			headerPingLabel.Text = pingVal .. "ms"
			if pingVal <= 150 then
				headerPingLabel.TextColor3 = Color3.fromRGB(0, 255, 120) -- Green
			elseif pingVal <= 199 then
				headerPingLabel.TextColor3 = Color3.fromRGB(255, 140, 0)  -- Orange
			else
				headerPingLabel.TextColor3 = Color3.fromRGB(255, 50, 50)   -- Red
			end
		end
	end

	if not isShootMurdererActive then return end
	
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	
	if tool then
		local screenPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
		local currentTime = tick()
		
		if clickState then
			performAutoFire(screenPos)
			clickState = false
			lastActionTime = currentTime
		else
			if currentTime - lastActionTime >= delayBetweenClicks then
				clickState = true
				lastActionTime = currentTime
			end
		end
	end
end)

