local function getCharacterParts()
	local character = LocalPlayer.Character
	if not character then return nil, nil, nil end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	return character, rootPart, humanoid
end

local function getExactCoinCFrame(coinObj)
	if coinObj and coinObj.Parent then
		if coinObj:IsA("BasePart") then
			return coinObj.CFrame
		elseif coinObj:IsA("Model") then
			if coinObj.PrimaryPart then
				return coinObj.PrimaryPart.CFrame
			else
				local part = coinObj:FindFirstChildWhichIsA("BasePart", true)
				if part then return part.CFrame end
			end
		end
	end
	return nil
end

local function updateTargetAnchor(cframe)
	if not currentTargetAnchor or not currentTargetAnchor.Parent then
		currentTargetAnchor = Instance.new("Part")
		currentTargetAnchor.Name = "TargetCoinAnchor"
		currentTargetAnchor.Size = Vector3.new(1, 1, 1)
		currentTargetAnchor.Transparency = 1
		currentTargetAnchor.CanCollide = false
		currentTargetAnchor.Anchored = true
		currentTargetAnchor.Parent = Workspace
	end
	currentTargetAnchor.CFrame = cframe
	return currentTargetAnchor.Position
end

local function equipGun()
	local gun = getGun()
	if not gun then return false end
	if gun.Parent == LocalPlayer.Character then return true end
	if gun.Parent == LocalPlayer:FindFirstChild("Backpack") then
		local char = LocalPlayer.Character
		if char then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:EquipTool(gun)
				for _ = 1, 10 do
					task.wait(0.1)
					if gun.Parent == char then return true end
				end
			end
		end
	end
	return false
end

local function unequipGun()
	local char = LocalPlayer.Character
	if not char then return end
	local gun = getGun()
	if gun and gun.Parent == char then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then gun.Parent = backpack end
	end
end

local function getMurd()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local bp = plr:FindFirstChild("Backpack")
			local char = plr.Character
			if (bp and bp:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
				return plr
			end
		end
	end
	return nil
end

local function shootMurd()
	if not equipGun() then return end
	task.wait(0.2)
	
	local murd = getMurd()
	local screenPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	
	if murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = LocalPlayer.Character.HumanoidRootPart
		local mHrp = murd.Character.HumanoidRootPart
		hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(mHrp.Position.X, hrp.Position.Y, mHrp.Position.Z))
		
		-- Convert target 3D world position to Viewport 2D position for VirtualUser
		local viewportPoint, onScreen = Camera:WorldToViewportPoint(mHrp.Position)
		if onScreen then
			screenPos = Vector2.new(viewportPoint.X, viewportPoint.Y)
		end
	end
	
	-- Fire using performAutoFire
	performAutoFire(screenPos)
end

local function killAll()
	local knife = getKnife()
	if not knife then return end
	local events = knife:FindFirstChild("Events")
	if not events then return end
	local handleTouched = events:FindFirstChild("HandleTouched")
	if not handleTouched then return end
	local targets = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local upperTorso = p.Character:FindFirstChild("UpperTorso")
			if upperTorso then table.insert(targets, upperTorso) end
		end
	end
	for _, upperTorso in ipairs(targets) do
		handleTouched:FireServer(upperTorso)
	end
end

