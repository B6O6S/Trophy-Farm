-- Instant Auto-Rejoin On Kick
local function attemptRejoin()
	if not isAutoRejoinActive then return end
	task.spawn(function()
		while isAutoRejoinActive do
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
			end)
			task.wait(1)
		end
	end)
end

local function setupAutoRejoin()
	GuiService.ErrorMessageChanged:Connect(function()
		local errorMessage = GuiService:GetErrorMessage()
		if errorMessage and errorMessage ~= "" then
			attemptRejoin()
		end
	end)

	pcall(function()
		local coreGui = game:GetService("CoreGui")
		coreGui.ChildAdded:Connect(function(child)
			if child.Name == "RobloxPromptDialog" then
				attemptRejoin()
