-- Find Friend or Random Target To Keep Alive
local function findTargetToKeepAlive()
	local friendsFound = {}
	local otherPlayers = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("UpperTorso") then
			if WHITELISTED_FRIENDS[p.Name] or WHITELISTED_FRIENDS[p.DisplayName] then
				table.insert(friendsFound, p)
			else
				table.insert(otherPlayers, p)
			end
		end
	end

	if #friendsFound > 0 then
		return friendsFound[1]
	elseif #otherPlayers > 0 then
		return otherPlayers[math.random(1, #otherPlayers)]
	end

	return nil
end

-- Smart Auto Kill All (Fires ONCE per spawn, leaves 1 protected friend/random alive, skips if <= 2 players)
local function killAllExceptProtected(forceKillAll)
	local allPlayers = Players:GetPlayers()
	if #allPlayers <= 2 then
		return
	end

	if hasKilledThisSpawn and not forceKillAll then
		return
	end

	equipKnife()
	local knife = getKnife()
	if not knife then return end
	local events = knife:FindFirstChild("Events")
	if not events then return end
	local handleTouched = events:FindFirstChild("HandleTouched")
	if not handleTouched then return end

	if not protectedTargetPlayer or not protectedTargetPlayer.Parent or not protectedTargetPlayer.Character then
		protectedTargetPlayer = findTargetToKeepAlive()
	end

	local targets = {}
	for _, p in ipairs(allPlayers) do
		if p ~= LocalPlayer and p.Character then
			local upperTorso = p.Character:FindFirstChild("UpperTorso")
			if upperTorso then
				if forceKillAll then
					table.insert(targets, upperTorso)
				else
					if p ~= protectedTargetPlayer then
						table.insert(targets, upperTorso)
					end
				end
			end
		end
	end

	for _, upperTorso in ipairs(targets) do
		handleTouched:FireServer(upperTorso)
	end

	if not forceKillAll then
		hasKilledThisSpawn = true
	end

	task.defer(unequipTools)
end

-- Auto Vote Task
local PAD_NAMES = { "VotePad1", "VotePad2", "VotePad3" }
local ORDER = { 
	"Manor", "House 2", "Office 3", "Hospital 3", "Bank 2", 
	"Vampire's Castle", "Mansion 2", "WorkPlace", "Hotel 2", 
	"Farm House", "Police Station", "Factory", "Bio Lab", 
	"Research Facility", "Mil Base"
}

local function normalize(s)
	s = string.lower(s):gsub("-", " "):gsub("%s+", " ")
	return s:match("^%s*(.-)%s*$")
end

local function stripParen(s)
	local p = string.find(s, " (", 1, true)
	return p and s:sub(1, p - 1) or s
end

local RANK_SMALL = {}
for i, name in ipairs(ORDER) do
	local full = normalize(name)
	local base = stripParen(full)
	RANK_SMALL[full] = i
	if not RANK_SMALL[base] then RANK_SMALL[base] = i + 0.05 end
end

local function getOpenPads()
	local open = {}
	local lobby = Workspace:FindFirstChild("Lobby")
	local folder = lobby and lobby:FindFirstChild("VotePads")
	if not folder then return open end
	for _, name in ipairs(PAD_NAMES) do
		local pad = folder:FindFirstChild(name)
		local trigger = pad and pad:FindFirstChild("Pad")
		local gui = pad and pad:FindFirstChild("VoteInfoGui")
		local container = gui and gui:FindFirstChild("Container")
		local label = container and container:FindFirstChild("MapName")
		if trigger and label and gui.Enabled then
			table.insert(open, { trigger = trigger, gui = gui, map = label.Text })
		end
	end
	return open
end

local function pickSmallest(open)
	local best, bestScore = nil, math.huge
	for _, p in ipairs(open) do
		local low = normalize(p.map)
		local clean = stripParen(low)
		local score = RANK_SMALL[low] or RANK_SMALL[clean] or 999
		if score < bestScore then best, bestScore = p, score end
	end
	return best
end

task.spawn(function()
	while true do
		task.wait(0.2)
		if isAutoVoteActive then
			pcall(function()
				local open = getOpenPads()
				if #open > 0 then
					local target = pickSmallest(open)
					if target and target.trigger and target.trigger.Parent then
						local char = LocalPlayer.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						local hrp = hum and hum.RootPart
						if hrp and hum.Health > 0 and char ~= votedChar then
							isCurrentlyVoting = true
							isScriptTeleporting = true
							hrp.Anchored = false
							local safePos = target.trigger.Position + Vector3.new(0, 3, 0)
							hrp.CFrame = CFrame.new(safePos)
							lastPosition = hrp.Position
							if firetouchinterest then
								pcall(firetouchinterest, hrp, target.trigger, 0)
								pcall(firetouchinterest, hrp, target.trigger, 1)
							end
							task.wait(0.12)
							if hum and hum.Health > 0 then
								votedChar = char
								hum:ChangeState(Enum.HumanoidStateType.Dead)
								hum.Health = 0
							end
							task.delay(0.2, function() isScriptTeleporting = false end)
						end
					end
				else
					votedChar = nil
					isCurrentlyVoting = false
				end
			end)
		else
			isCurrentlyVoting = false
		end
	end
end)

