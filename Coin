-- ==================== COIN AURA METHODS ====================
local function touch(a, b)
	pcall(function()
		firetouchinterest(a, b, 0)
		firetouchinterest(a, b, 1)
	end)
end

local function getCoinContainers()
	local containers = {}
	for _, map in ipairs(Workspace:GetChildren()) do
		local container = map:FindFirstChild("CoinContainer")
		if container then
			table.insert(containers, container)
		end
	end
	return containers
end

local function getCoinParts(containers)
	local parts = {}
	for _, container in ipairs(containers) do
		for _, descendant in ipairs(container:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant:FindFirstChild("TouchInterest") then
				table.insert(parts, descendant)
			end
		end
	end
	return parts
end

local function isTargetCoin(desc)
	return desc.Name == "Coin_Server" or desc.Name == "CoinVisual"
end

local function isCoinFading(part)
	if not part or not part.Parent then return true end
	if part:IsA("BasePart") then
		return part.Transparency > 0.1
	elseif part:IsA("Model") then
		local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
		return primary and primary.Transparency > 0.1
	end
	return false
end

-- Tool & Weapon Identification & Force Equip Logic
local function getGun()
	local char = LocalPlayer.Character
	if char then
		local g = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
		if g then return g end
	end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		local g = bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")
		if g then return g end
	end
	return nil
end

local function hasGun()
	return getGun() ~= nil
end

local function equipGun()
	local gun = getGun()
	if not gun then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	if gun.Parent == char then return true end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:UnequipTools()
		task.wait(0.05)
		humanoid:EquipTool(gun)
		pcall(function() gun.Parent = char end)
		task.wait(0.1)
		return gun.Parent == char
	end
	return false
end

local function getKnife()
	local char = LocalPlayer.Character
	if char then
		local k = char:FindFirstChild("Knife")
		if k then return k end
	end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		local k = bp:FindFirstChild("Knife")
		if k then return k end
	end
	return nil
end

local function hasKnife()
	return getKnife() ~= nil
end

local function equipKnife()
	local knife = getKnife()
	if not knife then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	if knife.Parent == char then return true end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:UnequipTools()
		task.wait(0.05)
		humanoid:EquipTool(knife)
		pcall(function() knife.Parent = char end)
		task.wait(0.1)
		return knife.Parent == char
	end
	return false
end

local function hasWeapon()
	return hasKnife() or hasGun()
end

