								pcall(firetouchinterest, hrp, target.trigger, 0)
								pcall(firetouchinterest, hrp, target.trigger, 1)
							end
							task.wait(0.12)
							if hum and hum.Health > 0 then
								votedChar = char
								hum:ChangeState(Enum.HumanoidStateType.Dead)
								hum.Health = 0
							end
							task.delay(0.2, function() isScriptTeleporting = false end)
						end
					end
				else
					votedChar = nil
					isCurrentlyVoting = false
					if wasVotingActive then
						wasVotingActive = false
						isWaitingAfterVote = true
						postVoteStartTime = tick()
					end
				end
			end)
		else
			isCurrentlyVoting = false
			wasVotingActive = false
		end
	end
end)

--------------------------------------------------------
-- EXTERNAL TELEPORT DETECTION & PLATFORM SNAPBACK
--------------------------------------------------------
local lastDetectedPosition = nil

task.spawn(function()
	while true do
		task.wait(0.05)
		pcall(function()
			local character, rootPart, humanoid = getCharacterParts()
			if character and rootPart and humanoid and humanoid.Health > 0 then
				local currentPos = rootPart.Position
				
				if lastDetectedPosition then
					local distanceMoved = (currentPos - lastDetectedPosition).Magnitude
					if distanceMoved > 35 then
						if isScriptTeleporting or isBotTeleporting or isWaitingAfterVote or isWaitingAfterRespawn or isBagFull or isCurrentlyVoting or isAutoVoteActive or (getOpenPads() and #getOpenPads() > 0) then
							-- Ignore script-driven, voting, or respawn timer teleports entirely
						else
							-- Game teleported you! Instantly teleport onto the safe platform surface at (99999, 99999 + 1.2, 99999)
							rootPart.CFrame = CFrame.new(99999, 99999 + 1.2, 99999)
							rootPart.AssemblyLinearVelocity = Vector3.zero
							rootPart.AssemblyAngularVelocity = Vector3.zero
						end
					end
				end
				
				lastDetectedPosition = rootPart.Position
			end
		end)
	end
end)

--------------------------------------------------------
-- MAIN HEARTBEAT AUTOMATION LOOP
--------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	local character, rootPart, humanoid = getCharacterParts()

	-- Enable Noclip on character parts when Auto Farm is active
	if isFarmingActive and character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if isAutoGrabGunActive and not hasGun() and not hasKnife() and rootPart then
		pcall(function()
			local gunDrop = Workspace:FindFirstChild("GunDrop", true)
			if gunDrop then
				local targetPart = nil
				if gunDrop:IsA("BasePart") then
					targetPart = gunDrop
				elseif gunDrop:IsA("Model") then
					targetPart = gunDrop.PrimaryPart or gunDrop:FindFirstChildWhichIsA("BasePart", true)
				end
				
				if targetPart then
					targetPart.CFrame = rootPart.CFrame
				end
			end
		end)
	end

	local containers = getCoinContainers()
	local allDescendants = {}
	for _, container in ipairs(containers) do
		local coinFolder = container:FindFirstChild("CoinFolder") or container
		for _, desc in ipairs(coinFolder:GetDescendants()) do
			if isTargetCoin(desc) then table.insert(allDescendants, desc) end
		end
	end

	-- Count active un-faded coins
	local activeCoinCount = 0
	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) then
			activeCoinCount = activeCoinCount + 1
		end
	end

	if activeCoinCount >= 3 and lastActiveCoinCount < 3 then
		hasInstantTeleportedThisSpawn = false
		coinsThisSpawn = 0
	end
	lastActiveCoinCount = activeCoinCount

	-- Handle 18-Second Wait After Respawn, then TP to Safe Platform Surface (99999, 99999 + 1.2, 99999)
	if isWaitingAfterRespawn and rootPart and humanoid then
		local elapsedRespawn = tick() - respawnTimerStartTime
		if elapsedRespawn >= 18 then
			isWaitingAfterRespawn = false
			isScriptTeleporting = true
			rootPart.Anchored = false
			rootPart.CFrame = CFrame.new(99999, 99999 + 1.2, 99999)
			lastPosition = rootPart.Position
			task.delay(0.2, function() isScriptTeleporting = false end)
		else
			rootPart.Anchored = false
			humanoid.PlatformStand = false
			return
		end
	end

	-- Handle 18-Second Wait After Voting, then TP to Safe Platform Surface (99999, 99999 + 1.2, 99999)
	if isWaitingAfterVote and rootPart and humanoid then
		local elapsedPostVote = tick() - postVoteStartTime
		if elapsedPostVote >= 18 then
			isWaitingAfterVote = false
			isScriptTeleporting = true
			rootPart.Anchored = false
			rootPart.CFrame = CFrame.new(99999, 99999 + 1.2, 99999)
			lastPosition = rootPart.Position
			task.delay(0.2, function() isScriptTeleporting = false end)
		else
			rootPart.Anchored = false
			humanoid.PlatformStand = false
			return
		end
	end

	if isShowCoinsActive then
		local activeCoinMap = {}
		for _, part in ipairs(allDescendants) do
			if not isCoinFading(part) then
				activeCoinMap[part] = true
				if not coinHighlights[part] then
					local hl = Instance.new("Highlight")
					hl.Name = "CoinEspHighlight"
					hl.Adornee = part
					hl.FillTransparency = 0.3
					hl.OutlineTransparency = 1
					
					local coinColor = Color3.fromRGB(255, 215, 0)
					if part:IsA("BasePart") then
						coinColor = part.Color
					elseif part:IsA("Model") then
						local bp = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)
						if bp then coinColor = bp.Color end
					end
					hl.FillColor = coinColor
					hl.Parent = part
					coinHighlights[part] = hl
				else
					local bp = part:IsA("BasePart") and part or (part:IsA("Model") and (part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true)))
					if bp and coinHighlights[part] then
						coinHighlights[part].FillColor = bp.Color
					end
				end
			end
		end
		for part, hl in pairs(coinHighlights) do
			if not activeCoinMap[part] or not part.Parent or isCoinFading(part) then
				if hl then hl:Destroy() end
				coinHighlights[part] = nil
			end
		end
	else
		if next(coinHighlights) then
			for _, hl in pairs(coinHighlights) do
				if hl then hl:Destroy() end
			end
			coinHighlights = {}
		end
	end

	if character and rootPart and isFarmingActive and not isBagFull then
		if isShootMurdererActive and isBagFull then
			return
		end

		local radius = isCoinAuraActive and 1000 or 15
		local rootPos = rootPart.Position
		local coinParts = getCoinParts(containers)
		
		for coinObj, info in pairs(trackedPickupCoins) do
			if not info.picked then
				if isCoinFading(coinObj) or not coinObj.Parent then
					info.picked = true
					
					if not farmStartTime then
						farmStartTime = tick()
					end

					coinsCollectedSession = coinsCollectedSession + 1
					coinsThisSpawn = coinsThisSpawn + 1
					
					pcall(function()
						local remotes = ReplicatedStorage:FindFirstChild("Remotes")
						local gameplay = remotes and remotes:FindFirstChild("gameplay")
						local coinCollected = gameplay and gameplay:FindFirstChild("CoinCollected")
						if coinCollected then
							coinCollected:FireServer("Candy", 0, 50, "table: 0xbe3383760cf18974")
						end
					end)
				end
			end
		end

		for _, part in ipairs(coinParts) do
			local cf = getExactCoinCFrame(part)
			if cf then
				local heightOffset = settingsData.HeightOffset
				local targetPosWithOffset = cf.Position + Vector3.new(0, heightOffset, 0)
				local dist = (rootPos - targetPosWithOffset).Magnitude
				if dist <= radius then
					touch(rootPart, part)
					if dist <= 3.5 and not trackedPickupCoins[part] then
						trackedPickupCoins[part] = { touchedAt = tick(), picked = false }
					end
				end
			end
		end
	end

	if not isFarmingActive then
		if rootPart and not isAutoVoteActive and not isCurrentlyVoting then
			rootPart.Anchored = false
			if humanoid then humanoid.PlatformStand = false end
		end
		return
	end

	if activeCoinCount < 3 then
		if rootPart and not isAutoVoteActive and not isCurrentlyVoting then
			rootPart.Anchored = false
			if humanoid then 
				humanoid.PlatformStand = false 
			end
		end
		return
	end

	if not character or not rootPart or not humanoid or humanoid.Health > 0 == false then
		return
	end

	local unvisitedCount = 0
	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) then
			if not visitedCoins[part] then 
				unvisitedCount = unvisitedCount + 1 
			end
		end
	end

	if unvisitedCount == 0 then visitedCoins = {} end

	if isBagFull then
		visitedCoins = {}
		if currentTargetAnchor then currentTargetAnchor:Destroy() currentTargetAnchor = nil end
		
		-- ==================== FULL BAG ACTIONS (INSTANT EXECUTION) ====================
		if not hasHandledFullBag then
			hasHandledFullBag = true

			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			rootPart.Anchored = false

			if humanoid then
				humanoid.PlatformStand = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = true end
			end

			if hasKnife() and isAutoKillAllActive then
				pcall(killAll)
			elseif hasGun() then
				isScriptTeleporting = true
				rootPart.CFrame = CFrame.new(99999, 99999 + 1.2, 99999)
				lastPosition = rootPart.Position
				task.delay(0.2, function() isScriptTeleporting = false end)
			else
				task.spawn(function()
					while isBagFull and isFarmingActive do
						local murd = getMurd()
						if murd then
							isScriptTeleporting = true
							pcall(function()
								resetPlayer(murd)
							end)
							task.wait(0.05)
							isScriptTeleporting = false
						end
						task.wait(0.2)
					end
				end)
			end
		end

		return
	end

	local closestPart, closestCF = nil, nil
	local shortestDistance = math.huge
	local rootPos = rootPart.Position

	local murdHrpPos = nil
	if isAvoidMurdererActive then
		local murd = getMurd()
		if murd and murd.Character then
			local hrp = murd.Character:FindFirstChild("HumanoidRootPart") or murd.Character:FindFirstChild("UpperTorso")
			if hrp then murdHrpPos = hrp.Position end
		end
	end

	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) and not visitedCoins[part] then
			local cf = getExactCoinCFrame(part)
			if cf then
				local heightOffset = settingsData.HeightOffset
				local targetPosWithOffset = cf.Position + Vector3.new(0, heightOffset, 0)
				
				local shouldSkip = false
				if murdHrpPos then
					local distToMurd = (targetPosWithOffset - murdHrpPos).Magnitude
					if distToMurd <= 22 then
						shouldSkip = true
					else
						local toCoin = (targetPosWithOffset - rootPos).Unit
						local toMurd = (murdHrpPos - rootPos)
						local proj = toMurd:Dot(toCoin)
						if proj > 0 and proj < (targetPosWithOffset - rootPos).Magnitude then
							local closestPointOnPath = rootPos + (toCoin * proj)
							if (closestPointOnPath - murdHrpPos).Magnitude < 18 then
								shouldSkip = true
							end
						end
					end
				end

				if not shouldSkip then
					local distanceToTarget = (rootPos - targetPosWithOffset).Magnitude
					if distanceToTarget < shortestDistance then
						shortestDistance = distanceToTarget
						closestPart = part
						closestCF = cf
					end
				end
			end
		end
	end

	if closestPart and closestCF then
		rootPart.Anchored = false
		isScriptTeleporting = false

		local exactCoinPos = updateTargetAnchor(closestCF)
		local speed = settingsData.Speed
		local heightOffset = settingsData.HeightOffset
		local finalTargetPos = exactCoinPos + Vector3.new(0, heightOffset, 0)

		local targetPosition = finalTargetPos
		local currentPosition = rootPart.Position
		local distance = (targetPosition - currentPosition).Magnitude

		if currentFarmType == "Standing" or currentFarmType == "Lay on back" then
			humanoid.PlatformStand = true
			for _, desc in ipairs(character:GetDescendants()) do
				if desc:IsA("Motor6D") then
					desc.CurrentAngle = 0
				end
			end
		end

		-- Strict Single Instant Teleport Only ONCE per Spawn Batch (Only if distance is 500+ studs away)
		if not hasInstantTeleportedThisSpawn then
			hasInstantTeleportedThisSpawn = true
			if distance >= 500 then
				isScriptTeleporting = true
				rootPart.Anchored = false
				if currentFarmType == "Lay on back" then
					rootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(math.rad(90), 0, math.rad(90))
				else
					rootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(0, 0, 0)
				end
				lastPosition = rootPart.Position
				task.delay(0.2, function() isScriptTeleporting = false end)
			end
		else
			local direction = targetPosition - currentPosition
			rootPart.AssemblyLinearVelocity = direction.Unit * speed
			
			local currentPos = rootPart.Position
			if currentFarmType == "Lay on back" then
				rootPart.CFrame = CFrame.new(currentPos.X, currentPos.Y, currentPos.Z) * CFrame.Angles(math.rad(90), 0, math.rad(90))
			else
				rootPart.CFrame = CFrame.new(currentPos.X, currentPos.Y, currentPos.Z) * CFrame.Angles(0, 0, 0)
			end
			
			lastPosition = rootPart.Position

			if distance <= 2.5 then
				visitedCoins[closestPart] = true
			end
		end
	else
		if currentTargetAnchor then currentTargetAnchor:Destroy() currentTargetAnchor = nil end
		if not isAutoVoteActive and not isCurrentlyVoting then
			rootPart.Anchored = false
			if humanoid then 
				humanoid.PlatformStand = false 
			end
		end
	end
end)
