-- CUSTOM TARGET RESET METHOD (STICKY INFINITE LOOP)
--------------------------------------------------------
local function resetPlayer(TargetPlayer)
    if not TargetPlayer or not TargetPlayer.Parent then return end
    
    while isBagFull and isFarmingActive and TargetPlayer.Parent do
        local tChar = TargetPlayer.Character
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not tHum or tHum.Health <= 0 then break end

        local character = localPlayer.Character
        if not character then break end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = humanoid and humanoid.RootPart
        if not (character and humanoid and rootPart and tChar) then break end

        local tRootPart = tChar:FindFirstChild("HumanoidRootPart")
        local tHead = tChar:FindFirstChild("Head")
        if not tRootPart then break end

        humanoid.PlatformStand = true

        -- Apply extreme downward velocity to force physics calculations
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, -50000, 0)
        bv.Parent = rootPart

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 1000000
        bg.Parent = rootPart

        local originalDestroyHeight = Workspace.FallenPartsDestroyHeight
        Workspace.FallenPartsDestroyHeight = 0/0

        local startTime = tick()
        local resetDuration = 1.2
        local completed = false

        local conn
        conn = RunService.Heartbeat:Connect(function()
            local currentTargetChar = TargetPlayer.Character
            local currentTargetRoot = currentTargetChar and currentTargetChar:FindFirstChild("HumanoidRootPart")
            local currentTargetHead = currentTargetChar and currentTargetChar:FindFirstChild("Head")

            if tick() - startTime > resetDuration or not currentTargetChar or not currentTargetRoot or not currentTargetRoot.Parent or not isBagFull then
                Workspace.FallenPartsDestroyHeight = originalDestroyHeight
                if bv.Parent then bv:Destroy() end
                if bg.Parent then bg:Destroy() end
                humanoid.PlatformStand = false
                if conn then conn:Disconnect() end
                completed = true
                return
            end

            if currentTargetRoot and currentTargetRoot.Parent and character and character.Parent then
                local headPos = currentTargetHead and currentTargetHead.Position or (currentTargetRoot.Position + Vector3.new(0, 2.5, 0))
                
                -- Lock directly onto target head/root position and spin violently
                rootPart.CFrame = CFrame.new(headPos) * CFrame.Angles(math.pi / 2, 0, 0)
                rootPart.AssemblyLinearVelocity = Vector3.new(0, -50000, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(7500, 7500, 7500)
                
                -- Fire touch interest continuously to register impact
                pcall(function()
                    firetouchinterest(rootPart, currentTargetRoot, 0)
                    firetouchinterest(rootPart, currentTargetRoot, 1)
                    if currentTargetHead then
                        firetouchinterest(rootPart, currentTargetHead, 0)
                        firetouchinterest(rootPart, currentTargetHead, 1)
                    end
                end)
            end
        end)

        while not completed and TargetPlayer.Parent and isBagFull do
            task.wait(0.05)
        end

        if not completed then
            Workspace.FallenPartsDestroyHeight = originalDestroyHeight
            if bv.Parent then bv:Destroy() end
            if bg.Parent then bg:Destroy() end
            humanoid.PlatformStand = false
            if conn then conn:Disconnect() end
        end

        task.wait(0.1)
        local postChar = TargetPlayer.Character
        local postHum = postChar and postChar:FindFirstChildOfClass("Humanoid")
        if not postHum or postHum.Health <= 0 then break end
    end
end

