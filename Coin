-- HELPER COMBAT METHODS
--------------------------------------------------------
local function getCharacterParts()
	local character = LocalPlayer.Character
	if not character then return nil, nil, nil end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	return character, rootPart, humanoid
end

local function getExactCoinCFrame(coinObj)
	if coinObj and coinObj.Parent then
		if coinObj:IsA("BasePart") then
			return coinObj.CFrame
		elseif coinObj:IsA("Model") then
			if coinObj.PrimaryPart then
				return coinObj.PrimaryPart.CFrame
			else
				local part = coinObj:FindFirstChildWhichIsA("BasePart", true)
				if part then return part.CFrame end
			end
		end
	end
	return nil
end

local function updateTargetAnchor(cframe)
	if not currentTargetAnchor or not currentTargetAnchor.Parent then
		currentTargetAnchor = Instance.new("Part")
		currentTargetAnchor.Name = "TargetCoinAnchor"
		currentTargetAnchor.Size = Vector3.new(1, 1, 1)
		currentTargetAnchor.Transparency = 1
		currentTargetAnchor.CanCollide = false
		currentTargetAnchor.Anchored = true
		currentTargetAnchor.Parent = Workspace
	end
	currentTargetAnchor.CFrame = cframe
	return currentTargetAnchor.Position
end

local function equipGun()
	local gun = getGun()
	if not gun then return false end
	if gun.Parent == LocalPlayer.Character then return true end
	if gun.Parent == LocalPlayer:FindFirstChild("Backpack") then
		local char = LocalPlayer.Character
		if char then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:EquipTool(gun)
				for _ = 1, 10 do
					task.wait(0.1)
					if gun.Parent == char then return true end
				end
			end
		end
	end
	return false
end

local function getMurd()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local bp = plr:FindFirstChild("Backpack")
			local char = plr.Character
			if (bp and bp:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
				return plr
			end
		end
	end
	return nil
end

local function shootMurd()
	if not equipGun() then return end
	task.wait(0.1)
	local murd = getMurd()
	if murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = LocalPlayer.Character.HumanoidRootPart
		local mHrp = murd.Character.HumanoidRootPart
		hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(mHrp.Position.X, hrp.Position.Y, mHrp.Position.Z))
	end
end

local function killAll()
	local knife = getKnife()
	if not knife then return end
	local events = knife:FindFirstChild("Events")
	if not events then return end
	local handleTouched = events:FindFirstChild("HandleTouched")
	if not handleTouched then return end
	local targets = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local upperTorso = p.Character:FindFirstChild("UpperTorso")
			if upperTorso then table.insert(targets, upperTorso) end
		end
	end
	for _, upperTorso in ipairs(targets) do
		handleTouched:FireServer(upperTorso)
	end
end

-- Auto Vote Task
local PAD_NAMES = { "VotePad1", "VotePad2", "VotePad3" }
local ORDER = { 
	"Manor", "House 2", "Office 3", "Hospital 3", "Bank 2", 
	"Vampire's Castle", "Mansion 2", "WorkPlace", "Hotel 2", 
	"Farm House", "Police Station", "Factory", "Bio Lab", 
	"Research Facility", "Mil Base"
}

local function normalize(s)
	s = string.lower(s):gsub("-", " "):gsub("%s+", " ")
	return s:match("^%s*(.-)%s*$")
end

local function stripParen(s)
	local p = string.find(s, " (", 1, true)
	return p and s:sub(1, p - 1) or s
end

local RANK_SMALL = {}
for i, name in ipairs(ORDER) do
	local full = normalize(name)
	local base = stripParen(full)
	RANK_SMALL[full] = i
	if not RANK_SMALL[base] then RANK_SMALL[base] = i + 0.05 end
end

local function getOpenPads()
	local open = {}
	local lobby = Workspace:FindFirstChild("Lobby")
	local folder = lobby and lobby:FindFirstChild("VotePads")
	if not folder then return open end
	for _, name in ipairs(PAD_NAMES) do
		local pad = folder:FindFirstChild(name)
		local trigger = pad and pad:FindFirstChild("Pad")
		local gui = pad and pad:FindFirstChild("VoteInfoGui")
		local container = gui and gui:FindFirstChild("Container")
		local label = container and container:FindFirstChild("MapName")
		if trigger and label and gui.Enabled then
			table.insert(open, { trigger = trigger, gui = gui, map = label.Text })
		end
	end
	return open
end

local function pickSmallest(open)
	local best, bestScore = nil, math.huge
	for _, p in ipairs(open) do
		local low = normalize(p.map)
		local clean = stripParen(low)
		local score = RANK_SMALL[low] or RANK_SMALL[clean] or 999
		if score < bestScore then best, bestScore = p, score end
	end
	return best
end

task.spawn(function()
	while true do
		task.wait(0.2)
		if isAutoVoteActive then
			pcall(function()
				local open = getOpenPads()
				if #open > 0 then
					local target = pickSmallest(open)
					if target and target.trigger and target.trigger.Parent then
						local char = LocalPlayer.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						local hrp = hum and hum.RootPart
						if hrp and hum.Health > 0 and char ~= votedChar then
							local safePos = target.trigger.Position + Vector3.new(0, 3, 0)
							hrp.CFrame = CFrame.new(safePos)
							if firetouchinterest then
