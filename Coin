-- AUTO VOTE BACKGROUND TASK
--------------------------------------------------------
local PAD_NAMES = { "VotePad1", "VotePad2", "VotePad3" }
local ORDER = { 
	"Manor", "House 2", "Office 3", "Hospital 3", "Bank 2", 
	"Vampire's Castle", "Mansion 2", "WorkPlace", "Hotel 2", 
	"Farm House", "Police Station", "Factory", "Bio Lab", 
	"Research Facility", "Mil Base"
}

local function normalize(s)
	s = string.lower(s):gsub("-", " "):gsub("%s+", " ")
	return s:match("^%s*(.-)%s*$")
end

local function stripParen(s)
	local p = string.find(s, " (", 1, true)
	return p and s:sub(1, p - 1) or s
end

local RANK_SMALL = {}
for i, name in ipairs(ORDER) do
	local full = normalize(name)
	local base = stripParen(full)
	RANK_SMALL[full] = i
	if not RANK_SMALL[base] then 
		RANK_SMALL[base] = i + 0.05 
	end
end

local function getOpenPads()
	local open = {}
	local lobby = Workspace:FindFirstChild("Lobby")
	local folder = lobby and lobby:FindFirstChild("VotePads")
	if not folder then return open end
	for _, name in ipairs(PAD_NAMES) do
		local pad = folder:FindFirstChild(name)
		local trigger = pad and pad:FindFirstChild("Pad")
		local gui = pad and pad:FindFirstChild("VoteInfoGui")
		local container = gui and gui:FindFirstChild("Container")
		local label = container and container:FindFirstChild("MapName")
		if trigger and label and gui.Enabled then
			table.insert(open, { trigger = trigger, gui = gui, map = label.Text })
		end
	end
	return open
end

local function pickSmallest(open)
	local best, bestScore = nil, math.huge
	for _, p in ipairs(open) do
		local low = normalize(p.map)
		local clean = stripParen(low)
		local score = RANK_SMALL[low] or RANK_SMALL[clean] or 999
		if score < bestScore then
			best, bestScore = p, score
		end
	end
	return best
end

task.spawn(function()
	while true do
		task.wait(0.2)
		if isAutoVoteActive then
			pcall(function()
				local open = getOpenPads()
				if #open > 0 then
					local target = pickSmallest(open)
					if target and target.trigger and target.trigger.Parent then
						local char = player.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						local hrp = hum and hum.RootPart
						
						if hrp and hum.Health > 0 and char ~= votedChar then
							local safePos = target.trigger.Position + Vector3.new(0, 3, 0)
							hrp.CFrame = CFrame.new(safePos)
							
							if firetouchinterest then
								pcall(firetouchinterest, hrp, target.trigger, 0)
								pcall(firetouchinterest, hrp, target.trigger, 1)
							end
							
							task.wait(0.12)
							
							if hum and hum.Health > 0 then
								votedChar = char
								hum:ChangeState(Enum.HumanoidStateType.Dead)
								hum.Health = 0
							end
						end
					end
				else
					votedChar = nil
				end
			end)
		end
	end
end)

--------------------------------------------------------
-- MAIN FARMING LOOP (No Platform Teleporting)
--------------------------------------------------------
RunService.Heartbeat:Connect(function()
	if not isFarmingActive then return end
	
	local character, rootPart, humanoid = getCharacterParts()
	if not character or not rootPart or not humanoid or humanoid.Health <= 0 then
		return
	end

	-- 1. Noclip: Disables wall collision across all character parts continuously
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end

	local bv = rootPart:FindFirstChild("SmoothFarmVelocity")
	if not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "SmoothFarmVelocity"
		bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bv.P = 20000
		bv.Parent = rootPart
	end

	local rootPos = rootPart.Position
	local currentRadius = tonumber(radiusBox.Text) or settingsData.AuraRadius
	local containers = getCoinContainers()
	local coinParts = getCoinParts(containers)

	-- 2. TouchInterest Coin Aura Execution
	for _, part in ipairs(coinParts) do
		if not isCoinFading(part) then
			if (rootPos - part.Position).Magnitude <= currentRadius then
				touch(rootPart, part)
			end
		end
	end

	-- 3. Find closest valid coin part that is NOT fading/transparent and NOT the one we just finished
	local closestPart = nil
	local closestCF = nil
	local shortestDistance = math.huge

	local allDescendants = {}
	for _, container in ipairs(containers) do
		for _, desc in ipairs(container:GetDescendants()) do
			if isTargetCoin(desc) then
				table.insert(allDescendants, desc)
			end
		end
	end

	for _, part in ipairs(allDescendants) do
		if not isCoinFading(part) and part ~= lastTargetPart then
			local cf = getExactCoinCFrame(part)
			if cf then
				local heightOffset = tonumber(heightBox.Text) or settingsData.HeightOffset
				local targetPosWithOffset = cf.Position + Vector3.new(0, heightOffset, 0)
				local distanceToTarget = (rootPos - targetPosWithOffset).Magnitude

				if distanceToTarget < shortestDistance then
					shortestDistance = distanceToTarget
					closestPart = part
					closestCF = cf
				end
			end
		end
	end

	if closestPart and closestCF then
		statusLabel.Text = "Status: Farming..."
		
		-- Create / position anchor part at exact target coin CFrame
		local exactCoinPos = updateTargetAnchor(closestCF)
		
		local speed = tonumber(speedBox.Text) or settingsData.Speed
		local heightOffset = tonumber(heightBox.Text) or settingsData.HeightOffset
		local finalTargetPos = exactCoinPos + Vector3.new(0, heightOffset, 0)

		-- Prevent humanoid from auto-getting up mid-farming
		humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)

		-- Accurate coin movement with forced laying posture (90-degree back rotation)
		local targetPosition = finalTargetPos
		local currentPosition = rootPart.Position
		local distance = (targetPosition - currentPosition).Magnitude

		if distance >= 500 then
			-- Teleport when the coin is very far away
			rootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(math.rad(90), 0, 0)
			bv.Velocity = Vector3.zero
		else
			local direction = targetPosition - currentPosition

			if distance > 0.15 then
				-- Move directly toward the exact target while laying on back
				bv.Velocity = direction.Unit * speed
				rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(math.rad(90), 0, 0)
			else
				-- Correct remaining positional error, snap precisely, and immediately skip to the next coin
				bv.Velocity = Vector3.zero
				rootPart.CFrame = CFrame.new(targetPosition) * CFrame.Angles(math.rad(90), 0, 0)
				lastTargetPart = closestPart
			end
		end
	else
		-- Reset last target tracker when waiting
		lastTargetPart = nil
		
		if currentTargetAnchor then
			currentTargetAnchor:Destroy()
			currentTargetAnchor = nil
		end
		
		bv.Velocity = Vector3.zero
		statusLabel.Text = "Status: Waiting (No coins)..."
	end
end)
